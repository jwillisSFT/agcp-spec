{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.ai/implementer/AGCP-Implementation-Profile-Schema.json",
  "title": "AGCP Implementation Profile Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "document",
    "profile",
    "baseline",
    "conformance",
    "intended_use",
    "implementation",
    "deployment_topology",
    "assurance_boundary",
    "interfaces",
    "trust_boundaries",
    "governance_functions",
    "identity_and_authorization",
    "cryptography",
    "canonical_state",
    "schema_validation",
    "compilation_and_activation",
    "pem_runtime",
    "enforcement",
    "persistence",
    "background_processing",
    "idempotency",
    "validation_pipeline",
    "http",
    "reevaluation",
    "metadata",
    "backup_and_recovery",
    "performance_qualification",
    "operational_values",
    "repository_corrections",
    "observed_evidence",
    "profile_specific_tests",
    "required_decision_records",
    "approval",
    "revision_history"
  ],
  "$defs": {
    "controlledProfileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "digest"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "SHA-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "format_version",
        "authoritative_representation",
        "canonicalization",
        "digest"
      ],
      "properties": {
        "artifact_type": {
          "const": "AGCP_IMPLEMENTATION_PROFILE"
        },
        "format_version": {
          "const": "2.0.0"
        },
        "authoritative_representation": {
          "enum": [
            "YAML",
            "JSON"
          ]
        },
        "human_readable_rendering": {
          "type": "string",
          "minLength": 1
        },
        "canonicalization": {
          "const": "RFC8785_JCS"
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "scope",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "SHA-256"
            },
            "scope": {
              "const": "PROFILE_DOCUMENT_EXCLUDING_DOCUMENT_DIGEST_VALUE"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "name",
        "profile_version",
        "status"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agcp_release"
      ],
      "properties": {
        "agcp_release": {
          "type": "string",
          "minLength": 1
        },
        "controlled_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_status",
        "claimed_scope"
      ],
      "properties": {
        "claim_status": {
          "type": "string",
          "minLength": 1
        },
        "claimed_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "intended_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "production_use": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_id",
        "implementation_version",
        "runtime_language"
      ],
      "properties": {
        "implementation_id": {
          "type": "string",
          "minLength": 1
        },
        "implementation_version": {
          "type": "string",
          "minLength": 1
        },
        "runtime_language": {
          "type": "string",
          "minLength": 1
        },
        "distribution_model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deployment_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_pattern",
        "runtime_units"
      ],
      "properties": {
        "deployment_pattern": {
          "type": "string",
          "minLength": 1
        },
        "runtime_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit_id",
              "responsibilities"
            ],
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1
              },
              "responsibilities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "trust_boundary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "scale_out_model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assurance_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_managed",
        "external_provider_managed",
        "not_claimed"
      ],
      "properties": {
        "implementation_managed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "external_provider_managed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_claimed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "if_001",
        "management",
        "test_control",
        "pem"
      ],
      "properties": {
        "if_001": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_path",
            "exposure"
          ],
          "properties": {
            "base_path": {
              "type": "string",
              "minLength": 1
            },
            "exposure": {
              "type": "string",
              "minLength": 1
            },
            "authentication": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "management": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implemented"
          ],
          "properties": {
            "implemented": {
              "type": "boolean"
            },
            "interface": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "test_control": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implemented"
          ],
          "properties": {
            "implemented": {
              "type": "boolean"
            },
            "interface": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "pem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interface_id",
            "runtime",
            "deterministic"
          ],
          "properties": {
            "interface_id": {
              "type": "string",
              "minLength": 1
            },
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "deterministic": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "trust_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposer_to_control_plane",
        "identity_to_control_plane",
        "gdf_to_grf",
        "grf_to_pep",
        "pep_to_target"
      ],
      "properties": {
        "proposer_to_control_plane": {
          "type": "string",
          "minLength": 1
        },
        "identity_to_control_plane": {
          "type": "string",
          "minLength": 1
        },
        "gdf_to_grf": {
          "type": "string",
          "minLength": 1
        },
        "grf_to_pep": {
          "type": "string",
          "minLength": 1
        },
        "pep_to_target": {
          "type": "string",
          "minLength": 1
        },
        "alternate_target_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "governance_functions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_qualification",
        "gdf_pdp",
        "execution_authorization",
        "grf",
        "pep",
        "target"
      ],
      "properties": {
        "proposal_qualification": {
          "type": "string",
          "minLength": 1
        },
        "gdf_pdp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placement",
            "workload_identity"
          ],
          "properties": {
            "placement": {
              "type": "string",
              "minLength": 1
            },
            "workload_identity": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "execution_authorization": {
          "type": "string",
          "minLength": 1
        },
        "grf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placement",
            "workload_identity",
            "co_located_with_gdf"
          ],
          "properties": {
            "placement": {
              "type": "string",
              "minLength": 1
            },
            "workload_identity": {
              "type": "string",
              "minLength": 1
            },
            "co_located_with_gdf": {
              "type": "boolean"
            }
          }
        },
        "pep": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placement",
            "workload_identity"
          ],
          "properties": {
            "placement": {
              "type": "string",
              "minLength": 1
            },
            "workload_identity": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identity_and_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authentication_model",
        "ias_profile",
        "resolution_point",
        "failure_behavior"
      ],
      "properties": {
        "authentication_model": {
          "type": "string",
          "minLength": 1
        },
        "ias_profile": {
          "$ref": "#/$defs/controlledProfileReference"
        },
        "resolution_point": {
          "type": "string",
          "minLength": 1
        },
        "qualified_context_consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "freshness_policy": {
          "type": "string",
          "minLength": 1
        },
        "failure_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cryptography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_algorithms",
        "key_management"
      ],
      "properties": {
        "provenance_algorithms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "key_management": {
          "type": "string",
          "minLength": 1
        },
        "trust_anchor_management": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "canonical_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_classes",
        "freshness_policy",
        "conflict_policy"
      ],
      "properties": {
        "source_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "freshness_policy": {
          "type": "string",
          "minLength": 1
        },
        "conflict_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schema_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_catalog",
        "validator_set"
      ],
      "properties": {
        "schema_catalog": {
          "type": "string",
          "minLength": 1
        },
        "validator_set": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fail_closed": {
          "type": "boolean"
        }
      }
    },
    "compilation_and_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governance_package_source",
        "activation_model"
      ],
      "properties": {
        "governance_package_source": {
          "type": "string",
          "minLength": 1
        },
        "activation_model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pem_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "side_effect_free",
        "network_access"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "side_effect_free": {
          "type": "boolean"
        },
        "network_access": {
          "type": "boolean"
        },
        "resource_limits": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pep_profiles",
        "selection_rule",
        "grf_to_pep_authentication",
        "pep_to_target_authority",
        "unsupported_mapping_behavior",
        "commit_execution_relationship"
      ],
      "properties": {
        "pep_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/controlledProfileReference"
          }
        },
        "selection_rule": {
          "type": "string",
          "minLength": 1
        },
        "grf_to_pep_authentication": {
          "type": "string",
          "minLength": 1
        },
        "pep_to_target_authority": {
          "type": "string",
          "minLength": 1
        },
        "unsupported_mapping_behavior": {
          "type": "string",
          "minLength": 1
        },
        "commit_execution_relationship": {
          "enum": [
            "ATOMIC",
            "ASYNCHRONOUS_OR_DISTINCT",
            "MIXED_BY_OPERATION"
          ]
        },
        "non_bypassability_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritative_stores",
        "ledger"
      ],
      "properties": {
        "authoritative_stores": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ledger": {
          "type": "string",
          "minLength": 1
        },
        "transaction_model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "background_processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "functions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "replay_protection"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "replay_protection": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation_pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordering"
      ],
      "properties": {
        "ordering": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_mapping",
        "not_found_policy"
      ],
      "properties": {
        "error_mapping": {
          "type": "string",
          "minLength": 1
        },
        "not_found_policy": {
          "type": "string",
          "minLength": 1
        },
        "rate_limiting": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reevaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_change_policy"
      ],
      "properties": {
        "material_change_policy": {
          "type": "string",
          "minLength": 1
        },
        "triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_metadata",
        "profile_binding_exposed"
      ],
      "properties": {
        "implementation_metadata": {
          "type": "string",
          "minLength": 1
        },
        "profile_binding_exposed": {
          "type": "boolean"
        },
        "public_safe_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "backup_and_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "covered_state",
        "recovery_integrity"
      ],
      "properties": {
        "covered_state": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recovery_integrity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "performance_qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "published_limits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "operational_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritative_source"
      ],
      "properties": {
        "authoritative_source": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "repository_corrections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observed_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_sources"
      ],
      "properties": {
        "evidence_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "profile_specific_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "description",
          "expected_result"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_decision_records": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "status"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
