{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.ai/implementer/AGCP-Identity-and-Authorization-Store-Profile-Schema.json",
  "title": "AGCP Identity and Authorization Store Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "sources",
    "subject_resolution",
    "authorization_facts",
    "source_composition",
    "freshness",
    "failure_behavior",
    "security",
    "evidence"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "digest"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "SHA-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "authoritative_fact_classes",
          "subject_identifiers",
          "resolution",
          "freshness"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "authoritative_fact_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "subject_identifiers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tenant_domain_scope": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "service_identity_reference": {
            "type": "string",
            "minLength": 1
          },
          "trust_basis": {
            "type": "string",
            "minLength": 1
          },
          "freshness": {
            "type": "string",
            "minLength": 1
          },
          "failure_behavior": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subject_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authenticated_subject_key",
        "stable_subject_key",
        "ambiguous_mapping_behavior"
      ],
      "properties": {
        "authenticated_subject_key": {
          "type": "string",
          "minLength": 1
        },
        "stable_subject_key": {
          "type": "string",
          "minLength": 1
        },
        "account_key": {
          "type": "string",
          "minLength": 1
        },
        "ambiguous_mapping_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authorization_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_classes"
      ],
      "properties": {
        "fact_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "semantics",
              "source_id"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "semantics": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "commitment_sensitive": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "source_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precedence",
        "conflict_behavior"
      ],
      "properties": {
        "precedence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflict_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_policy",
        "commit_revalidation"
      ],
      "properties": {
        "default_policy": {
          "type": "string",
          "minLength": 1
        },
        "commit_revalidation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failure_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unavailable",
        "stale",
        "conflict",
        "ineligible"
      ],
      "properties": {
        "unavailable": {
          "type": "string",
          "minLength": 1
        },
        "stale": {
          "type": "string",
          "minLength": 1
        },
        "conflict": {
          "type": "string",
          "minLength": 1
        },
        "ineligible": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_reference_policy",
        "least_privilege"
      ],
      "properties": {
        "credential_reference_policy": {
          "type": "string",
          "minLength": 1
        },
        "least_privilege": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_fields"
      ],
      "properties": {
        "recorded_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sensitive_data_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
