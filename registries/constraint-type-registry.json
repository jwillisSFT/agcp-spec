  "registry_rules": {
    "stability": "Constraint type identifiers are stable registry keys and SHALL NOT be repurposed.",
    "extensibility": "Implementations MAY define extension constraint types in an implementation or profile-specific namespace, provided extension constraints do not weaken AGCP normative behavior.",
    "unknown_constraint_type_behavior": "Unknown constraint types SHALL fail closed unless explicitly permitted by an applicable governed exception or extension profile.",
    "determinism": "Constraint evaluation SHALL be deterministic for identical authoritative inputs.",
    "evidence": "Constraint evaluation outcomes SHALL be reflected in Governance Evidence where the evaluation is governance-significant and attributable to a governed object."
  },
