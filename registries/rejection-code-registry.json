  "registry_rules": {
    "stability": "Rejection-code identifiers are stable registry keys and SHALL NOT be repurposed.",
    "extensibility": "Implementations MAY define extension rejection codes in a governed implementation-profile namespace without conflicting with registered AGCP codes.",
    "unknown_code_behavior": "Unknown rejection codes SHALL fail validation and SHALL NOT be presented as registered AGCP outcomes.",
    "determinism": "Code lookup and status mapping SHALL be deterministic for the applicable registry release.",
    "evidence": "Governance-significant rejection conditions SHALL preserve the evidence requirements declared by the registered code.",
    "public_not_found_normalization": "Public IF-001 protected-resource lookup failures SHALL use RESOURCE_NOT_FOUND. Resource-specific not-found codes are deprecated for public responses and may appear only in protected diagnostics or Governance Evidence.",
    "transport_rejection_separation": "REQUEST_THROTTLED and CAPACITY_UNAVAILABLE are pre-governance transport/service conditions and SHALL NOT be represented as authoritative Governance Outcomes."
  },
