{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.example/schemas/common.json",
  "title": "AGCP Common Types",
  "description": "Shared JSON Schema definitions for AGCP-conformant schemas. Specification release versioning is managed by repository release tags; this schema intentionally does not embed a schema_version field.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "uuid_like": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "governance_domain_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "governance_evidence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp_rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "hash_hex": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{16,128}$"
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "qualification_outcome_enum": {
      "type": "string",
      "enum": [
        "Qualified Proposal",
        "Structural Refusal"
      ]
    },
    "governance_outcome_enum": {
      "type": "string",
      "enum": [
        "Authorized",
        "Denied",
        "Structural Refusal",
        "Pending Human Review",
        "Deferred",
        "Governed Re-evaluation Required"
      ]
    },
    "execution_authorization_outcome_enum": {
      "type": "string",
      "enum": [
        "Authorized for Commit Boundary Processing",
        "Authorization Failure",
        "Governed Re-evaluation Required"
      ]
    },
    "commit_boundary_outcome_enum": {
      "type": "string",
      "enum": [
        "Commit Successful",
        "Commit Failed",
        "Governed Re-evaluation Required"
      ]
    },
    "continuation_outcome_enum": {
      "type": "string",
      "enum": [
        "Continue Execution",
        "DEGRADED",
        "Suspend Execution",
        "Resume Execution",
        "Governed Termination"
      ]
    },
    "constraint_outcome_enum": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_APPLICABLE"
      ]
    },
    "invariant_enforcement_enum": {
      "type": "string",
      "enum": [
        "Hard",
        "Soft"
      ]
    },
    "pass_fail_enum": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "tenant_state_enum": {
      "type": "string",
      "enum": [
        "PROVISIONED",
        "ACTIVE",
        "SUSPENDED",
        "DECOMMISSIONED"
      ]
    },
    "governance_artifact_status_enum": {
      "type": "string",
      "enum": [
        "Registered",
        "Validation Pending",
        "Accepted",
        "Rejected",
        "Active",
        "Retired",
        "Governed Re-evaluation Required"
      ]
    },
    "governance_pipeline_stage_enum": {
      "type": "string",
      "enum": [
        "Proposal Qualification",
        "Governance Decision Function",
        "Execution Authorization",
        "Commit Boundary",
        "Continuation Integrity",
        "Governance Evidence",
        "Tenant and Domain Isolation",
        "Delegation and Authority Lineage",
        "Cross-Domain Authority Isolation",
        "Governance Self-Protection",
        "Autonomous Coordination"
      ]
    },
    "rejection_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "A rejection code registered in registries/rejection-code-registry.json."
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sig": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8192
        },
        "payload_hash": {
          "$ref": "#/$defs/hash_hex"
        }
      },
      "required": [
        "alg",
        "kid",
        "sig"
      ]
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "principal_type": {
          "type": "string",
          "enum": [
            "AGENT",
            "SERVICE",
            "USER",
            "SYSTEM"
          ]
        },
        "display_name": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "principal_id",
        "principal_type"
      ]
    },
    "provenance": {
      "type": "object",
      "description": "Provenance envelope for governance-significant submitted inputs.",
      "additionalProperties": false,
      "properties": {
        "signer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "signed_at": {
          "$ref": "#/$defs/timestamp_rfc3339"
        }
      },
      "required": [
        "signer",
        "signature",
        "signed_at"
      ]
    },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_hash": {
          "$ref": "#/$defs/hash_hex"
        }
      },
      "required": [
        "policy_id"
      ]
    },
    "canonical_state_ref": {
      "type": "object",
      "description": "Reference to authoritative Canonical State used for governance processing.",
      "additionalProperties": false,
      "properties": {
        "canonical_state_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "canonical_state_hash": {
          "$ref": "#/$defs/hash_hex"
        },
        "resolved_at": {
          "$ref": "#/$defs/timestamp_rfc3339"
        }
      },
      "required": [
        "canonical_state_id"
      ]
    },
    "authority_lineage_ref": {
      "type": "object",
      "description": "Reference to Authority Lineage used for governance processing.",
      "additionalProperties": false,
      "properties": {
        "authority_lineage_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authority_lineage_hash": {
          "$ref": "#/$defs/hash_hex"
        }
      },
      "required": [
        "authority_lineage_id"
      ]
    },
    "governance_context_ref": {
      "type": "object",
      "description": "Reference to Governance Context associated with a Proposal.",
      "additionalProperties": false,
      "properties": {
        "governance_context_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "governance_context_hash": {
          "$ref": "#/$defs/hash_hex"
        }
      },
      "required": [
        "governance_context_id"
      ]
    },
    "governance_configuration_ref": {
      "type": "object",
      "description": "Reference to applicable governance configuration.",
      "additionalProperties": false,
      "properties": {
        "governance_configuration_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "governance_configuration_hash": {
          "$ref": "#/$defs/hash_hex"
        }
      },
      "required": [
        "governance_configuration_id"
      ]
    },
    "stage_evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "$ref": "#/$defs/governance_pipeline_stage_enum"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "stage",
        "ref"
      ]
    },
    "registry_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Repository release tag or registry release identifier."
        },
        "hash": {
          "$ref": "#/$defs/hash_hex"
        }
      },
      "required": [
        "name"
      ]
    }
  }
}
