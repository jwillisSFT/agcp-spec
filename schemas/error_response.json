{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.ai/schemas/error_response.json",
  "title": "AGCP ErrorResponse",
  "description": "Standard error response for AGCP HTTP interfaces. Transport and application errors remain distinct from Structural Refusal. When an interface conveys Structural Refusal, it references the canonical DS-028 Refusal Record rather than treating refusal as an ordinary error.",
  "x-agcp-ds-id": "DS-002",
  "x-agcp-lifecycle-state": "Implemented",
  "x-agcp-catalog": "catalog/schema-catalog.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rejection_code": {
          "$ref": "common.json#/$defs/rejection_code"
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "details": {
          "type": "object",
          "description": "Implementation-defined diagnostic information.",
          "additionalProperties": true
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "governance_stage": {
          "$ref": "common.json#/$defs/governance_pipeline_stage_enum"
        },
        "retryable": {
          "type": "boolean"
        },
        "governance_evidence_generated": {
          "type": "boolean",
          "description": "Indicates whether Governance Evidence was generated for this outcome."
        },
        "outcome_classification": {
          "type": "string",
          "enum": [
            "TRANSPORT_OR_APPLICATION_ERROR",
            "STRUCTURAL_REFUSAL"
          ],
          "description": "Distinguishes an interface/application error from an attributable governance Structural Refusal."
        },
        "refusal_record_ref": {
          "$ref": "refusal_record.json#/$defs/refusal_record_ref"
        }
      },
      "required": [
        "rejection_code",
        "message"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "governance_stage"
            ]
          },
          "then": {
            "required": [
              "governance_evidence_generated"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome_classification": {
                "const": "STRUCTURAL_REFUSAL"
              }
            },
            "required": [
              "outcome_classification"
            ]
          },
          "then": {
            "required": [
              "refusal_record_ref",
              "governance_stage",
              "governance_evidence_generated"
            ],
            "properties": {
              "governance_evidence_generated": {
                "const": true
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "error"
  ]
}
