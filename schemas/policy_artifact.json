{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.ai/schemas/policy_artifact.json",
  "title": "Governance Policy Artifact",
  "description": "Canonical, independently identifiable, attributable, versioned, integrity-protected representation of governance policy intent applicable to a defined Tenant, governance domain, and effective scope. It declares deterministic policy semantics, required governance inputs, authority, evidence, Canonical State, lifecycle, composite-governance, refusal-path, escalation, and commit requirements; binds those semantics to Governance Configuration; and references the DS-042 Compiled Governance Artifact and DS-043 Controlled Governance Activation records that make validated compiled policy authoritative. The policy artifact does not itself establish authority at commitment, determine Commit-Bound Admissibility, authorize execution, activate governance, or commit a transition.",
  "$comment": "DS-006 implements the policy-artifact aspects of ARM-204 and ARM-501 through ARM-512; Core Sections 7.2, 7.4, 14, 15.6A, 15.6B, and 15.7; NS-7.2-02, NS-7.4-01, NS-15.6A-01 through NS-15.6A-04, NS-15.6B-01, and NS-15.6B-02; and CR-007, CR-110 through CR-114, and CR-117. JSON Schema validates structural completeness, explicit policy semantics, protected-policy assertions, compilation and activation lifecycle consistency, integrity binding, and prohibition of arrival timing, hidden configuration, self-activation, or direct execution authority. Implementations must additionally verify semantic equivalence, cross-object identity equality, temporal ordering, policy applicability, source-intent traceability, cryptographic signatures, Constitutional Validation, Governance Omission Analysis, external approval, and deterministic replay.",
  "x-agcp-ds-id": "DS-006",
  "x-agcp-lifecycle-state": "Implemented",
  "x-agcp-catalog": "catalog/schema-catalog.json",
  "x-agcp-schema-role": "Canonical Governance Artifact — Governance Policy",
  "x-agcp-normative-basis": {
    "architecture_reference_model": [
      "ARM-204",
      "ARM-501",
      "ARM-502",
      "ARM-503",
      "ARM-504",
      "ARM-505",
      "ARM-506",
      "ARM-507",
      "ARM-508",
      "ARM-509",
      "ARM-510",
      "ARM-511",
      "ARM-512",
      "ARM-704"
    ],
    "core_sections": [
      "7.2",
      "7.4",
      "14",
      "15.6A",
      "15.6B",
      "15.7"
    ],
    "normative_statements": [
      "NS-7.2-02",
      "NS-7.4-01",
      "NS-15.6A-01",
      "NS-15.6A-02",
      "NS-15.6A-03",
      "NS-15.6A-04",
      "NS-15.6B-01",
      "NS-15.6B-02"
    ],
    "conformance_requirements": [
      "CR-007",
      "CR-110",
      "CR-111",
      "CR-112",
      "CR-113",
      "CR-114",
      "CR-117"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "policy_id": {
      "$ref": "#/$defs/policy_artifact_id"
    },
    "policy_version": {
      "$ref": "common.json#/$defs/version_string"
    },
    "policy_type": {
      "$ref": "#/$defs/policy_type"
    },
    "policy_classification": {
      "$ref": "#/$defs/policy_classification"
    },
    "status": {
      "$ref": "common.json#/$defs/governance_artifact_status_enum"
    },
    "tenant_id": {
      "$ref": "common.json#/$defs/tenant_id"
    },
    "governance_domain_id": {
      "$ref": "common.json#/$defs/governance_domain_id"
    },
    "effective_scope": {
      "$ref": "common.json#/$defs/governance_scope"
    },
    "source_governance_intent_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_governance_intent_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "policy_source_representation": {
      "$ref": "#/$defs/policy_source_representation"
    },
    "governance_configuration_binding": {
      "$ref": "#/$defs/governance_configuration_binding"
    },
    "policy_module_binding": {
      "$ref": "policy_evaluation_module_artifact.json#/$defs/policy_evaluation_module_artifact_ref"
    },
    "registry_bindings": {
      "$ref": "#/$defs/registry_bindings"
    },
    "policy_semantics": {
      "$ref": "#/$defs/policy_semantics"
    },
    "protected_governance_properties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/protected_governance_property"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "governance_approval_artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "governance_approval_artifact.json#/$defs/governance_approval_artifact_ref"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "compiled_governance_artifact_ref": {
      "$ref": "compiled_governance_artifact.json#/$defs/compiled_governance_artifact_ref"
    },
    "controlled_governance_activation_ref": {
      "$ref": "controlled_governance_activation.json#/$defs/controlled_governance_activation_ref"
    },
    "governance_version_ref": {
      "$ref": "common.json#/$defs/governance_version_ref"
    },
    "effective_from": {
      "$ref": "common.json#/$defs/timestamp_rfc3339"
    },
    "effective_until": {
      "$ref": "common.json#/$defs/timestamp_rfc3339"
    },
    "supersedes_policy_ref": {
      "$ref": "#/$defs/policy_artifact_ref"
    },
    "superseded_by_policy_ref": {
      "$ref": "#/$defs/policy_artifact_ref"
    },
    "lifecycle_change_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "governed_re_evaluation_basis": {
      "$ref": "#/$defs/governed_re_evaluation_basis"
    },
    "governance_evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "governance_evidence.json#/$defs/governance_evidence_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "created_at": {
      "$ref": "common.json#/$defs/timestamp_rfc3339"
    },
    "last_modified_at": {
      "$ref": "common.json#/$defs/timestamp_rfc3339"
    },
    "retired_at": {
      "$ref": "common.json#/$defs/timestamp_rfc3339"
    },
    "attribution": {
      "$ref": "common.json#/$defs/attribution"
    },
    "provenance": {
      "$ref": "common.json#/$defs/provenance"
    },
    "policy_digest": {
      "$ref": "common.json#/$defs/content_digest"
    },
    "integrity_signature": {
      "$ref": "common.json#/$defs/signature"
    },
    "replay_material": {
      "$ref": "#/$defs/replay_material"
    },
    "semantic_assertions": {
      "$ref": "#/$defs/semantic_assertions"
    },
    "display_summary": {
      "type": "object",
      "description": "Optional non-normative display metadata. It cannot alter canonical policy meaning.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true,
          "maxItems": 64
        }
      }
    },
    "extensions": {
      "$ref": "#/$defs/namespaced_extensions"
    }
  },
  "required": [
    "policy_id",
    "policy_version",
    "policy_type",
    "policy_classification",
    "status",
    "tenant_id",
    "governance_domain_id",
    "effective_scope",
    "source_governance_intent_refs",
    "policy_source_representation",
    "governance_configuration_binding",
    "registry_bindings",
    "policy_semantics",
    "governance_evidence_refs",
    "created_at",
    "attribution",
    "provenance",
    "policy_digest",
    "integrity_signature",
    "replay_material",
    "semantic_assertions"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "policy_classification": {
            "enum": [
              "PROTECTED",
              "CONSTITUTIONAL"
            ]
          }
        },
        "required": [
          "policy_classification"
        ]
      },
      "then": {
        "required": [
          "protected_governance_properties"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "policy_classification": {
            "const": "CONSTITUTIONAL"
          }
        },
        "required": [
          "policy_classification"
        ]
      },
      "then": {
        "properties": {
          "policy_semantics": {
            "properties": {
              "exceptionability": {
                "const": "NOT_EXCEPTIONABLE"
              }
            },
            "required": [
              "exceptionability"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_type": {
            "const": "GOVERNANCE_CHANGE"
          }
        },
        "required": [
          "policy_type"
        ]
      },
      "then": {
        "required": [
          "governance_approval_artifact_refs"
        ],
        "properties": {
          "semantic_assertions": {
            "properties": {
              "self_modification_requires_external_approval": {
                "const": true
              }
            },
            "required": [
              "self_modification_requires_external_approval"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Registered"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "compiled_governance_artifact_ref"
              ]
            },
            {
              "required": [
                "controlled_governance_activation_ref"
              ]
            },
            {
              "required": [
                "governance_version_ref"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "Compiled",
              "Validation Pending"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "policy_module_binding",
          "compiled_governance_artifact_ref"
        ],
        "properties": {
          "compiled_governance_artifact_ref": {
            "allOf": [
              {
                "$ref": "compiled_governance_artifact.json#/$defs/compiled_governance_artifact_ref"
              },
              {
                "properties": {
                  "compilation_status": {
                    "enum": [
                      "COMPILED",
                      "VALIDATION_PENDING",
                      "VALIDATED"
                    ]
                  }
                },
                "required": [
                  "compilation_status"
                ]
              }
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "controlled_governance_activation_ref"
              ]
            },
            {
              "required": [
                "governance_version_ref"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "Validated",
              "Accepted"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "policy_module_binding",
          "compiled_governance_artifact_ref"
        ],
        "properties": {
          "compiled_governance_artifact_ref": {
            "allOf": [
              {
                "$ref": "compiled_governance_artifact.json#/$defs/compiled_governance_artifact_ref"
              },
              {
                "properties": {
                  "compilation_status": {
                    "const": "VALIDATED"
                  }
                },
                "required": [
                  "compilation_status"
                ]
              }
            ]
          }
        },
        "not": {
          "required": [
            "governance_version_ref"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "Validation Failed",
              "Rejected"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "compiled_governance_artifact_ref",
          "lifecycle_change_reason"
        ],
        "properties": {
          "compiled_governance_artifact_ref": {
            "allOf": [
              {
                "$ref": "compiled_governance_artifact.json#/$defs/compiled_governance_artifact_ref"
              },
              {
                "properties": {
                  "compilation_status": {
                    "const": "INVALID"
                  }
                },
                "required": [
                  "compilation_status"
                ]
              }
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "controlled_governance_activation_ref"
              ]
            },
            {
              "required": [
                "governance_version_ref"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Activation Pending"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "policy_module_binding",
          "compiled_governance_artifact_ref",
          "controlled_governance_activation_ref"
        ],
        "properties": {
          "compiled_governance_artifact_ref": {
            "allOf": [
              {
                "$ref": "compiled_governance_artifact.json#/$defs/compiled_governance_artifact_ref"
              },
              {
                "properties": {
                  "compilation_status": {
                    "const": "VALIDATED"
                  }
                },
                "required": [
                  "compilation_status"
                ]
              }
            ]
          },
          "controlled_governance_activation_ref": {
            "allOf": [
              {
                "$ref": "controlled_governance_activation.json#/$defs/controlled_governance_activation_ref"
              },
              {
                "properties": {
                  "activation_status": {
                    "enum": [
                      "PREPARED",
                      "AUTHORIZED"
                    ]
                  }
                },
                "required": [
                  "activation_status"
                ]
              }
            ]
          }
        },
        "not": {
          "required": [
            "governance_version_ref"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "policy_module_binding",
          "compiled_governance_artifact_ref",
          "controlled_governance_activation_ref",
          "governance_version_ref",
          "effective_from"
        ],
        "properties": {
          "governance_configuration_binding": {
            "$ref": "governance_configuration.json#/$defs/governance_configuration_ref"
          },
          "compiled_governance_artifact_ref": {
            "allOf": [
              {
                "$ref": "compiled_governance_artifact.json#/$defs/compiled_governance_artifact_ref"
              },
              {
                "properties": {
                  "compilation_status": {
                    "const": "VALIDATED"
                  }
                },
                "required": [
                  "compilation_status"
                ]
              }
            ]
          },
          "controlled_governance_activation_ref": {
            "allOf": [
              {
                "$ref": "controlled_governance_activation.json#/$defs/controlled_governance_activation_ref"
              },
              {
                "properties": {
                  "activation_status": {
                    "const": "ACTIVATED"
                  }
                },
                "required": [
                  "activation_status",
                  "established_governance_version_ref",
                  "completed_at"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Activation Failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "compiled_governance_artifact_ref",
          "controlled_governance_activation_ref",
          "lifecycle_change_reason"
        ],
        "properties": {
          "compiled_governance_artifact_ref": {
            "allOf": [
              {
                "$ref": "compiled_governance_artifact.json#/$defs/compiled_governance_artifact_ref"
              },
              {
                "properties": {
                  "compilation_status": {
                    "const": "VALIDATED"
                  }
                },
                "required": [
                  "compilation_status"
                ]
              }
            ]
          },
          "controlled_governance_activation_ref": {
            "allOf": [
              {
                "$ref": "controlled_governance_activation.json#/$defs/controlled_governance_activation_ref"
              },
              {
                "properties": {
                  "activation_status": {
                    "const": "ACTIVATION_FAILED"
                  }
                },
                "required": [
                  "activation_status",
                  "completed_at"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "compiled_governance_artifact_ref",
          "controlled_governance_activation_ref",
          "governance_version_ref",
          "superseded_by_policy_ref",
          "lifecycle_change_reason"
        ],
        "properties": {
          "controlled_governance_activation_ref": {
            "allOf": [
              {
                "$ref": "controlled_governance_activation.json#/$defs/controlled_governance_activation_ref"
              },
              {
                "properties": {
                  "activation_status": {
                    "enum": [
                      "SUPERSEDED",
                      "ROLLED_BACK"
                    ]
                  }
                },
                "required": [
                  "activation_status"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "Deprecated",
              "Retired"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "compiled_governance_artifact_ref",
          "controlled_governance_activation_ref",
          "governance_version_ref",
          "lifecycle_change_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Retired"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "retired_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Governed Re-evaluation Required"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "compiled_governance_artifact_ref",
          "governed_re_evaluation_basis",
          "lifecycle_change_reason"
        ]
      }
    }
  ],
  "$defs": {
    "policy_artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
      "description": "Stable identifier for a Governance Policy artifact."
    },
    "policy_artifact_ref": {
      "type": "object",
      "description": "Integrity-bound reference to a DS-006 Governance Policy artifact.",
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/policy_artifact_id"
        },
        "policy_version": {
          "$ref": "common.json#/$defs/version_string"
        },
        "policy_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "artifact_uri": {
          "$ref": "common.json#/$defs/uri"
        },
        "tenant_id": {
          "$ref": "common.json#/$defs/tenant_id"
        },
        "governance_domain_id": {
          "$ref": "common.json#/$defs/governance_domain_id"
        },
        "status": {
          "$ref": "common.json#/$defs/governance_artifact_status_enum"
        },
        "effective_scope": {
          "$ref": "common.json#/$defs/governance_scope"
        },
        "governance_version_ref": {
          "$ref": "common.json#/$defs/governance_version_ref"
        },
        "compiled_governance_artifact_ref": {
          "$ref": "compiled_governance_artifact.json#/$defs/compiled_governance_artifact_ref"
        },
        "controlled_governance_activation_ref": {
          "$ref": "controlled_governance_activation.json#/$defs/controlled_governance_activation_ref"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "policy_digest",
        "artifact_uri",
        "tenant_id",
        "governance_domain_id",
        "status"
      ]
    },
    "policy_type": {
      "type": "string",
      "enum": [
        "AUTHORIZATION",
        "ADMISSIBILITY",
        "AUTHORITY",
        "EVIDENCE",
        "CANONICAL_STATE",
        "LIFECYCLE",
        "COMPOSITE_GOVERNANCE",
        "ENFORCEMENT",
        "ESCALATION",
        "GOVERNANCE_CHANGE",
        "GENERAL"
      ]
    },
    "policy_classification": {
      "type": "string",
      "enum": [
        "ORDINARY",
        "PROTECTED",
        "CONSTITUTIONAL"
      ]
    },
    "source_governance_intent_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "governance_intent_id": {
          "$ref": "common.json#/$defs/identifier"
        },
        "intent_version": {
          "$ref": "common.json#/$defs/version_string"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "POLICY_DOCUMENT",
            "CONSTITUTION_SPECIFICATION",
            "LEGAL_REQUIREMENT",
            "REGULATORY_REQUIREMENT",
            "RISK_REQUIREMENT",
            "ORGANIZATIONAL_REQUIREMENT",
            "TECHNICAL_REQUIREMENT",
            "COMPANION_SPECIFICATION"
          ]
        },
        "artifact_uri": {
          "$ref": "common.json#/$defs/uri"
        },
        "intent_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "accountable_owner": {
          "$ref": "common.json#/$defs/principal"
        }
      },
      "required": [
        "governance_intent_id",
        "intent_version",
        "source_type",
        "artifact_uri",
        "intent_digest"
      ]
    },
    "policy_source_representation": {
      "type": "object",
      "description": "Canonical source representation of policy intent before compilation.",
      "additionalProperties": false,
      "properties": {
        "representation_uri": {
          "$ref": "common.json#/$defs/uri"
        },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "representation_language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "representation_version": {
          "$ref": "common.json#/$defs/version_string"
        },
        "representation_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "canonicalization_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "human_readable": {
          "const": true
        }
      },
      "required": [
        "representation_uri",
        "media_type",
        "representation_language",
        "representation_version",
        "representation_digest",
        "human_readable"
