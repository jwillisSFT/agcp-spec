{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.example/schemas/governance_evidence.json",
  "title": "Governance Evidence",
  "description": "Canonical schema for Governance Evidence generated by AGCP governance-significant processing. Governance Evidence is the authoritative, immutable record supporting traceability, deterministic replay, conformance assessment, and lifecycle reconstruction.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "governance_evidence_id": {
      "$ref": "common.json#/$defs/governance_evidence_id"
    },
    "tenant_id": {
      "$ref": "common.json#/$defs/tenant_id"
    },
    "governance_domain_id": {
      "$ref": "common.json#/$defs/governance_domain_id"
    },
    "proposal_id": {
      "$ref": "common.json#/$defs/proposal_id"
    },
    "action_id": {
      "$ref": "common.json#/$defs/action_id"
    },
    "governance_stage": {
      "$ref": "common.json#/$defs/governance_pipeline_stage_enum"
    },
    "stage_outcome": {
      "type": "string",
      "description": "Implementation-independent outcome produced by the referenced governance stage."
    },
    "policy_ref": {
      "$ref": "common.json#/$defs/policy_ref"
    },
    "canonical_state_ref": {
      "$ref": "common.json#/$defs/canonical_state_ref"
    },
    "authority_lineage_ref": {
      "$ref": "common.json#/$defs/authority_lineage_ref"
    },
    "governance_context_ref": {
      "$ref": "common.json#/$defs/governance_context_ref"
    },
    "governance_configuration_ref": {
      "$ref": "common.json#/$defs/governance_configuration_ref"
    },
    "rejection_code": {
      "$ref": "common.json#/$defs/rejection_code"
    },
    "created_at": {
      "$ref": "common.json#/$defs/timestamp_rfc3339"
    },
    "artifact_hash": {
      "$ref": "common.json#/$defs/hash_hex"
    },
    "integrity_signature": {
      "$ref": "common.json#/$defs/signature"
    },
    "provenance": {
      "$ref": "common.json#/$defs/provenance"
    },
    "evidence": {
      "type": "object",
      "description": "Structured governance-stage evidence. Contents are stage-specific but SHALL be deterministic for identical authoritative inputs.",
      "additionalProperties": true
    },
    "related_evidence": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/stage_evidence_ref"
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "metadata": {
      "type": "object",
      "description": "Implementation-defined metadata that does not alter normative semantics.",
      "additionalProperties": true
    }
  },
  "required": [
    "governance_evidence_id",
    "tenant_id",
    "proposal_id",
    "governance_stage",
    "stage_outcome",
    "created_at",
    "integrity_signature"
  ]
}
