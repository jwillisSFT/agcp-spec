{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.ai/schemas/governance_evidence.json",
  "title": "Governance Evidence",
  "description": "Canonical immutable Governance Evidence record. It contains typed evidence-item references, explicit ordering, integrity digests, attributable provenance-chain continuity, qualification results, Governance Ledger references, and links to canonical governance outcomes. Raw or arbitrary evidence payloads are not normative content; governance-significant evidence is represented through typed, resolvable, digest-bound artifact references.",
  "$comment": "DS-020 is the canonical evidence container and reference owner. Evidence qualification is represented by DS-033; the existence of an evidence artifact alone does not establish freshness, authority, integrity, resolvability, sufficiency, or availability.",
  "x-agcp-ds-id": "DS-020",
  "x-agcp-lifecycle-state": "Implemented",
  "x-agcp-catalog": "catalog/schema-catalog.json",
  "x-agcp-schema-role": "Governance Evidence Record",
  "x-agcp-normative-basis": {
    "architecture_reference_model": [
      "ARM-101",
      "ARM-102",
      "ARM-105",
      "ARM-108",
      "ARM-204",
      "ARM-308",
      "ARM-401",
      "ARM-504",
      "ARM-505",
      "ARM-509",
      "ARM-601",
      "ARM-602",
      "ARM-603",
      "ARM-604",
      "ARM-605",
      "ARM-606",
      "ARM-607",
      "ARM-608",
      "ARM-609",
      "ARM-610",
      "ARM-701",
      "ARM-706",
      "ARM-709",
      "ARM-710",
      "ARM-801",
      "ARM-807"
    ],
    "core_sections": [
      "7.4",
      "7.5",
      "7.6A",
      "9.6A",
      "9.6B",
      "10.1",
      "10.2",
      "10.3",
      "10.4",
      "10.5",
      "10.6",
      "10.7",
      "10.8",
      "10.9"
    ],
    "normative_statements": [
      "NS-7.4-01",
      "NS-7.5-02",
      "NS-7.6A-01",
      "NS-7.6A-02",
      "NS-9.6A-01",
      "NS-9.6A-02",
      "NS-10.1-02",
      "NS-10.2-01",
      "NS-10.3-01",
      "NS-10.4-01",
      "NS-10.5-01",
      "NS-10.6-01",
      "NS-10.7-01",
      "NS-10.8-01",
      "NS-10.9-01"
    ],
    "conformance_requirements": [
      "CR-041",
      "CR-047",
      "CR-048",
      "CR-049",
      "CR-050",
      "CR-051",
      "CR-052",
      "CR-062",
      "CR-063",
      "CR-064",
      "CR-065",
      "CR-066",
      "CR-067",
      "CR-068",
      "CR-069",
      "CR-097",
      "CR-103",
      "CR-104",
      "CR-105",
      "CR-106",
      "CR-107",
      "CR-108",
      "CR-109"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "governance_evidence_id": {
      "$ref": "common.json#/$defs/governance_evidence_id"
    },
    "record_type": {
      "const": "GOVERNANCE_EVIDENCE"
    },
    "proposal_ref": {
      "$ref": "governed_action_proposal.json#/$defs/governed_action_proposal_ref"
    },
    "action_id": {
      "$ref": "common.json#/$defs/action_id"
    },
    "tenant_id": {
      "$ref": "common.json#/$defs/tenant_id"
    },
    "governance_domain_id": {
      "$ref": "common.json#/$defs/governance_domain_id"
    },
    "target_ref": {
      "$ref": "common.json#/$defs/target_ref"
    },
    "governance_stage": {
      "$ref": "common.json#/$defs/governance_pipeline_stage_enum"
    },
    "stage_outcome": {
      "$ref": "#/$defs/stage_outcome"
    },
    "evaluation_horizon": {
      "$ref": "common.json#/$defs/evaluation_horizon"
    },
    "governance_version_ref": {
      "$ref": "common.json#/$defs/governance_version_ref"
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "$ref": "policy_artifact.json#/$defs/policy_artifact_ref"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "governance_context_ref": {
      "$ref": "governance_context_envelope.json#/$defs/governance_context_envelope_ref"
    },
    "canonical_state_ref": {
      "$ref": "canonical_state.json#/$defs/canonical_state_ref"
    },
    "authority_lineage_ref": {
      "$ref": "authority_lineage.json#/$defs/authority_lineage_ref"
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_item"
      },
      "minItems": 1,
      "maxItems": 2048
    },
    "evidence_set_digest": {
      "$ref": "common.json#/$defs/content_digest"
    },
    "evidence_qualification_result_refs": {
      "type": "array",
      "items": {
        "$ref": "evidence_qualification_result.json#/$defs/evidence_qualification_result_ref"
      },
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true
    },
    "provenance_chain": {
      "$ref": "#/$defs/provenance_chain"
    },
    "ordering_basis": {
      "$ref": "#/$defs/ordering_basis"
    },
    "governance_decision_refs": {
      "type": "array",
      "items": {
        "$ref": "governance_decision_result.json#/$defs/governance_decision_result_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "execution_authorization_refs": {
      "type": "array",
      "items": {
        "$ref": "execution_authorization_view.json#/$defs/execution_authorization_view_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "commit_boundary_request_refs": {
      "type": "array",
      "items": {
        "$ref": "commit_boundary_request.json#/$defs/commit_boundary_request_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "commit_boundary_result_refs": {
      "type": "array",
      "items": {
        "$ref": "commit_boundary_result.json#/$defs/commit_boundary_result_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "approval_artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "governance_approval_artifact.json#/$defs/governance_approval_artifact_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "governance_receipt_refs": {
      "type": "array",
      "items": {
        "$ref": "governance_receipt.json#/$defs/governance_receipt_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "refusal_record_refs": {
      "type": "array",
      "items": {
        "$ref": "refusal_record.json#/$defs/refusal_record_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "state_qualification_result_refs": {
      "type": "array",
      "items": {
        "$ref": "state_qualification_result.json#/$defs/state_qualification_result_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "authority_rederivation_result_refs": {
      "type": "array",
      "items": {
        "$ref": "authority_rederivation_result.json#/$defs/authority_rederivation_result_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "bind_set_refs": {
      "type": "array",
      "items": {
        "$ref": "bind_set.json#/$defs/bind_set_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "dependency_graph_refs": {
      "type": "array",
      "items": {
        "$ref": "governance_dependency_graph.json#/$defs/governance_dependency_graph_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "resulting_state_validation_result_refs": {
      "type": "array",
      "items": {
        "$ref": "resulting_state_validation_result.json#/$defs/resulting_state_validation_result_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "deterministic_adjudication_result_refs": {
      "type": "array",
      "items": {
        "$ref": "deterministic_adjudication_result.json#/$defs/deterministic_adjudication_result_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "governance_binding_validation_result_refs": {
      "type": "array",
      "items": {
        "$ref": "governance_binding_validation_result.json#/$defs/governance_binding_validation_result_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "enforcement_context_refs": {
      "type": "array",
      "items": {
        "$ref": "enforcement_context.json#/$defs/enforcement_context_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "ledger_event_refs": {
      "type": "array",
      "items": {
        "$ref": "governance_ledger_event.json#/$defs/governance_ledger_event_ref"
      },
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true
    },
    "created_at": {
      "$ref": "common.json#/$defs/timestamp_rfc3339"
    },
    "attribution": {
      "$ref": "common.json#/$defs/attribution"
    },
    "record_digest": {
      "$ref": "common.json#/$defs/content_digest"
    },
    "integrity_signature": {
      "$ref": "common.json#/$defs/signature"
    },
    "replay_material": {
      "$ref": "#/$defs/replay_material"
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced implementation extensions that cannot alter canonical governance meaning.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]+:[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": true,
      "maxProperties": 64
    },
    "exception_artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "exception_artifact.json#/$defs/exception_artifact_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "governance_lifecycle_record_refs": {
      "type": "array",
      "items": {
        "$ref": "governance_lifecycle_record.json#/$defs/governance_lifecycle_record_ref"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "lifecycle_transition_refs": {
      "type": "array",
      "items": {
        "$ref": "governance_lifecycle_record.json#/$defs/lifecycle_transition_ref"
      },
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true
    },
    "continuation_integrity_result_refs": {
      "type": "array",
      "items": {
        "$ref": "continuation_integrity_result.json#/$defs/continuation_integrity_result_ref"
      },
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "governance_evidence_id",
    "record_type",
    "proposal_ref",
    "tenant_id",
    "governance_domain_id",
    "target_ref",
    "governance_stage",
    "stage_outcome",
    "evaluation_horizon",
    "governance_version_ref",
    "policy_refs",
    "evidence_items",
    "evidence_set_digest",
    "provenance_chain",
    "ordering_basis",
    "created_at",
    "attribution",
    "record_digest",
    "integrity_signature",
    "replay_material"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "stage_outcome": {
            "const": "STRUCTURAL_REFUSAL"
          }
        },
        "required": [
          "stage_outcome"
        ]
      },
      "then": {
        "required": [
          "refusal_record_refs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage_outcome": {
            "enum": [
              "SUCCESS",
              "FAILURE",
              "DEFERRED",
              "RE_EVALUATION_REQUIRED",
              "RECORDED"
            ]
          }
        },
        "required": [
          "stage_outcome"
        ]
      },
      "then": {
        "not": {
          "required": [
            "refusal_record_refs"
          ]
        }
      }
    }
  ],
  "$defs": {
    "governance_evidence_ref": {
      "type": "object",
      "description": "Stable attributable and integrity-bound reference to DS-020 Governance Evidence.",
      "additionalProperties": false,
      "properties": {
        "governance_evidence_id": {
          "$ref": "common.json#/$defs/governance_evidence_id"
        },
        "governance_stage": {
          "$ref": "common.json#/$defs/governance_pipeline_stage_enum"
        },
        "evidence_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "created_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "evidence_uri": {
          "$ref": "common.json#/$defs/uri"
        },
        "proposal_id": {
          "$ref": "common.json#/$defs/proposal_id"
        },
        "tenant_id": {
          "$ref": "common.json#/$defs/tenant_id"
        },
        "governance_domain_id": {
          "$ref": "common.json#/$defs/governance_domain_id"
        }
      },
      "required": [
        "governance_evidence_id",
        "evidence_digest"
      ]
    },
    "stage_outcome": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILURE",
        "STRUCTURAL_REFUSAL",
        "DEFERRED",
        "RE_EVALUATION_REQUIRED",
        "INDETERMINATE",
        "RECORDED"
      ]
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "type": "string",
          "enum": [
            "PROPOSAL",
            "GOVERNANCE_CONTEXT",
            "CANONICAL_STATE",
            "AUTHORITY_LINEAGE",
            "DELEGATION",
            "APPROVAL",
            "DECISION",
            "AUTHORIZATION",
            "EXCEPTION",
            "CONSTRAINT_EVALUATION",
            "INVARIANT_EVALUATION",
            "STATE_QUALIFICATION",
            "EVIDENCE_QUALIFICATION",
            "AUTHORITY_REDERIVATION",
            "BIND_SET",
            "DEPENDENCY_GRAPH",
            "RESULTING_STATE_VALIDATION",
            "DETERMINISTIC_ADJUDICATION",
            "BINDING_VALIDATION",
            "ENFORCEMENT_CONTEXT",
            "COMMIT_REQUEST",
            "COMMIT_RESULT",
            "RECEIPT",
            "REFUSAL",
            "LEDGER_EVENT",
            "LIFECYCLE",
            "CONTINUATION",
            "PROFILE_DEFINED"
          ]
        },
        "artifact_id": {
          "$ref": "common.json#/$defs/identifier"
        },
        "artifact_uri": {
          "$ref": "common.json#/$defs/uri"
        },
        "artifact_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "artifact_type",
        "artifact_id",
        "artifact_digest"
      ]
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_item_id": {
          "$ref": "common.json#/$defs/identifier"
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "IDENTITY",
            "ATTRIBUTION",
            "POLICY",
            "CONSTRAINT",
            "INVARIANT",
            "STATE",
            "AUTHORITY",
            "DELEGATION",
            "APPROVAL",
            "DECISION",
            "AUTHORIZATION",
            "DEPENDENCY",
            "ADJUDICATION",
            "BINDING",
            "ENFORCEMENT",
            "COMMIT",
            "LIFECYCLE",
            "CONTINUATION",
            "PROVENANCE",
            "INTEGRITY",
            "OTHER_PROFILED"
          ]
        },
        "evidence_role": {
          "type": "string",
          "enum": [
            "REQUIRED_INPUT",
            "SUPPORTING_INPUT",
            "DERIVED_RESULT",
            "COUNTEREVIDENCE",
            "ORDERING_EVIDENCE",
            "REPLAY_EVIDENCE"
          ]
        },
        "artifact_ref": {
          "$ref": "#/$defs/artifact_reference"
        },
        "source_classification": {
          "type": "string",
          "enum": [
            "AUTHORITATIVE_GOVERNANCE_SOURCE",
            "GOVERNANCE_DERIVED",
            "NON_AUTHORITATIVE_CONTEXT"
          ]
        },
        "source_ref": {
          "$ref": "common.json#/$defs/authoritative_source_ref"
        },
        "observed_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "effective_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "expires_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "availability": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "resolvability": {
          "type": "string",
          "enum": [
            "RESOLVED",
            "UNRESOLVED",
            "UNKNOWN"
          ]
        },
        "ledger_position": {
          "$ref": "governance_ledger_event.json#/$defs/ledger_position"
        },
        "qualification_result_ref": {
          "$ref": "evidence_qualification_result.json#/$defs/evidence_qualification_result_ref"
        }
      },
      "required": [
        "evidence_item_id",
        "evidence_type",
        "evidence_role",
        "artifact_ref",
        "source_classification",
        "observed_at",
        "availability",
        "resolvability"
      ]
    },
    "provenance_chain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "$ref": "common.json#/$defs/provenance"
        },
        "predecessor_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/governance_evidence_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "continuity_outcome": {
          "type": "string",
          "enum": [
            "CONTINUOUS",
            "GAP_DETECTED",
            "INDETERMINATE"
          ]
        },
        "continuity_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "origin",
        "continuity_outcome",
        "continuity_digest"
      ]
    },
    "ordering_basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ordering_type": {
          "type": "string",
          "enum": [
            "GOVERNANCE_LEDGER_ORDER",
            "CAUSAL_PREDECESSOR_ORDER",
            "POLICY_DEFINED_ORDER",
            "COMPOSITE_DEPENDENCY_ORDER"
          ]
        },
        "ledger_position": {
          "$ref": "governance_ledger_event.json#/$defs/ledger_position"
        },
        "predecessor_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/governance_evidence_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "ordering_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "arrival_time_used_as_governance_basis": {
          "const": false
        }
      },
      "required": [
        "ordering_type",
        "ordering_digest",
        "arrival_time_used_as_governance_basis"
      ]
    },
    "replay_material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_set_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "evidence_set_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "governance_version_ref": {
          "$ref": "common.json#/$defs/governance_version_ref"
        },
        "replay_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "input_set_digest",
        "evidence_set_digest",
        "governance_version_ref",
        "replay_profile"
      ]
    }
  }
}
