    "enforcement_result": {
      "type": "object",
      "description": "Attributable Policy Enforcement Point result bound to DS-029 Enforcement Context.",
      "additionalProperties": false,
      "properties": {
        "policy_enforcement_point_id": {
          "$ref": "common.json#/$defs/policy_enforcement_point_id"
        },
        "enforcement_context_ref": {
          "$ref": "#/$defs/enforcement_context_ref"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PERMITTED",
            "PREVENTED",
            "FAILED_CLOSED",
            "RE_EVALUATION_REQUIRED"
          ]
        },
        "enforced_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "result_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "governance_evidence_ref": {
          "$ref": "governance_evidence.json#/$defs/governance_evidence_ref"
        },
        "mismatch_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "policy_enforcement_point_id",
        "enforcement_context_ref",
        "outcome",
        "enforced_at",
        "result_digest"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "PREVENTED",
                  "FAILED_CLOSED",
                  "RE_EVALUATION_REQUIRED"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "mismatch_reasons"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "PERMITTED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "not": {
              "required": [
                "mismatch_reasons"
              ]
            }
          }
        }
      ]
    }
  }
