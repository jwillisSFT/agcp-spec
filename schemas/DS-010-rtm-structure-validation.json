        {
          "cell": "AG112",
          "before": "Reconciled Core, CRs, ARM, NS, and TCs for AGCP v.2.0. DS-042 records outcome-specific Constitutional Validation and prohibits activation eligibility unless validation passes. DS-043 prohibits authoritative activation unless every compiled artifact is validated, constitutionally validated, omission-analysis-passed, self-protection-passed, and activation eligible.",
          "after": "Reconciled Core, CRs, ARM, NS, and TCs for AGCP v.2.0. DS-042 records outcome-specific Constitutional Validation and prohibits activation eligibility unless validation passes. DS-043 prohibits authoritative activation unless every compiled artifact is validated, constitutionally validated, omission-analysis-passed, self-protection-passed, and activation eligible. DS-010 provides the externally observable integrity-bound read model for the applicable compilation, validation, activation, Governance Version, lineage, approval, and evidence state."
        },
        {
          "cell": "Q113",
          "before": "spec/AGCP-Core.docx;spec/AGCP-Policy-Evaluation-Contract.md;registries/invariant-type-registry.json;conformance/AGCP-Conformance-Test-Vectors.md;conformance/test-mapping.json;schemas/compiled_governance_artifact.json;schemas/controlled_governance_activation.json",
