          "after": "RTM-1.29"
        },
        {
          "cell": "AG113",
          "before": "Reconciled Core, CRs, ARM, NS, and TCs for AGCP v.2.0. DS-042 requires preservation of governance intent, constraints, invariants, refusal paths, escalation semantics, evidence requirements, authority rules, commit meaning, and non-derogable protected constraints. DS-043 requires package-wide validation and atomic activation so compiled artifacts that weaken protected constraints cannot become authoritative.",
          "after": "Reconciled Core, CRs, ARM, NS, and TCs for AGCP v.2.0. DS-042 requires preservation of governance intent, constraints, invariants, refusal paths, escalation semantics, evidence requirements, authority rules, commit meaning, and non-derogable protected constraints. DS-043 requires package-wide validation and atomic activation so compiled artifacts that weaken protected constraints cannot become authoritative. DS-010 provides the externally observable integrity-bound read model for the applicable compilation, validation, activation, Governance Version, lineage, approval, and evidence state."
        },
        {
          "cell": "Q114",
          "before": "spec/AGCP-Core.docx;spec/AGCP-Policy-Evaluation-Contract.md;registries/invariant-type-registry.json;conformance/AGCP-Conformance-Test-Vectors.md;conformance/test-mapping.json;schemas/compiled_governance_artifact.json;schemas/controlled_governance_activation.json",
