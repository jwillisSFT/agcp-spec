    "binding_issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "type": "string",
          "enum": [
            "PROPOSAL",
            "DECISION",
            "AUTHORIZATION",
            "AUTHORITY",
            "EVIDENCE",
            "TARGET",
            "TENANT",
            "POLICY",
            "CANONICAL_STATE",
            "LIFECYCLE_STATE",
            "SCOPE",
            "VALIDITY",
            "GOVERNANCE_VERSION",
            "BIND_CONDITIONS"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "governance_evidence.json#/$defs/governance_evidence_ref"
          },
          "minItems": 1,
          "maxItems": 256
        }
      },
      "required": [
        "dimension",
        "code",
        "description"
      ]
    },
    "replay_material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "validation_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evaluated_binding_snapshot_ref": {
          "$ref": "common.json#/$defs/uri"
        },
        "current_binding_snapshot_ref": {
          "$ref": "common.json#/$defs/uri"
        },
        "comparison_algorithm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "governance_version_ref": {
          "$ref": "common.json#/$defs/governance_version_ref"
        },
        "input_set_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "historical_action_execution_required": {
          "const": false
        }
      },
      "required": [
        "validation_profile",
        "evaluated_binding_snapshot_ref",
        "current_binding_snapshot_ref",
        "comparison_algorithm_id",
        "governance_version_ref",
        "input_set_digest",
        "historical_action_execution_required"
      ]
    },
