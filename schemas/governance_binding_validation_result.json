{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.ai/schemas/governance_binding_validation_result.json",
  "title": "Governance Binding Validation Result",
  "description": "Canonical, independently identifiable and traceable result of determining immediately before enforcement and commitment whether the proposal remains bound to the same governance decision, execution authorization, current proposal-specific authority, qualified evidence, target, Tenant, governance domain, policy, qualified Canonical State, Derived Lifecycle State, scope, validity window, Governance Version, and applicable composite bind conditions previously evaluated by governance. It prevents substitution, detachment, cross-tenant transfer, stale or mismatched input use, invalid replay, and ungoverned partial binding. A valid result permits Enforcement Context assembly and continued Commit-Bound Admissibility processing but does not itself authorize execution, establish authority, apply enforcement, or commit a transition.",
  "$comment": "DS-030 implements ARM-203, Core Section 9.6A, and NS-9.6A-01 through NS-9.6A-02. Every required governance relationship is rechecked against current qualified inputs immediately before enforcement and commitment. JSON Schema enforces the result structure and outcome consistency; implementation validation must additionally compare referenced identities, digests, scopes, timestamps, and governed conditions for semantic equality.",
  "x-agcp-ds-id": "DS-030",
  "x-agcp-lifecycle-state": "Implemented",
  "x-agcp-catalog": "catalog/schema-catalog.json",
  "x-agcp-schema-role": "Commit-Time Governance Binding Validation Result",
  "x-agcp-normative-basis": {
    "architecture_reference_model": [
      "ARM-202",
      "ARM-203",
      "ARM-205",
      "ARM-206",
      "ARM-207",
      "ARM-208",
      "ARM-212",
      "ARM-213"
    ],
    "core_sections": [
      "9.6A",
      "9.6B"
    ],
    "normative_statements": [
      "NS-9.6A-01",
      "NS-9.6A-02",
      "NS-9.6A-04",
      "NS-9.6B-03",
      "NS-9.6B-05"
    ],
    "conformance_requirements": [
      "CR-102",
      "CR-107",
      "CR-109"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evaluation_id": {
      "$ref": "common.json#/$defs/evaluation_id"
    },
    "result_type": {
      "const": "GOVERNANCE_BINDING_VALIDATION_RESULT"
    },
    "evaluation_stage": {
      "const": "IMMEDIATELY_BEFORE_ENFORCEMENT_AND_COMMITMENT"
    },
    "proposal_identity": {
      "$ref": "common.json#/$defs/proposal_identity"
    },
    "tenant_id": {
      "$ref": "common.json#/$defs/tenant_id"
    },
    "governance_domain_id": {
      "$ref": "common.json#/$defs/governance_domain_id"
    },
    "evaluation_horizon": {
      "$ref": "common.json#/$defs/evaluation_horizon"
    },
    "evaluated_binding": {
      "$ref": "#/$defs/governance_binding"
    },
    "current_binding": {
      "$ref": "#/$defs/governance_binding"
    },
    "comparison_basis": {
      "$ref": "#/$defs/comparison_basis"
    },
    "dimension_results": {
      "$ref": "#/$defs/binding_dimension_results"
    },
    "outcome": {
      "$ref": "#/$defs/binding_validation_outcome"
    },
    "disposition": {
      "$ref": "#/$defs/binding_validation_disposition"
    },
    "mismatch_reasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding_issue"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "re_evaluation_reasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding_issue"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "missing_input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "supporting_qualified_evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence_qualification_result.json#/$defs/qualified_evidence_ref"
      },
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true
    },
    "evaluated_at": {
      "$ref": "common.json#/$defs/timestamp_rfc3339"
    },
    "evaluator": {
      "$ref": "common.json#/$defs/attribution"
    },
    "input_set_digest": {
      "$ref": "common.json#/$defs/content_digest"
    },
    "result_digest": {
      "$ref": "common.json#/$defs/content_digest"
    },
    "replay_material": {
      "$ref": "#/$defs/replay_material"
    },
    "semantic_assertions": {
      "$ref": "#/$defs/semantic_assertions"
    },
    "extensions": {
      "$ref": "#/$defs/namespaced_extensions"
    }
  },
  "required": [
    "evaluation_id",
    "result_type",
    "evaluation_stage",
    "proposal_identity",
    "tenant_id",
    "governance_domain_id",
    "evaluation_horizon",
    "evaluated_binding",
    "current_binding",
    "comparison_basis",
    "dimension_results",
    "outcome",
    "disposition",
    "supporting_qualified_evidence",
    "evaluated_at",
    "evaluator",
    "input_set_digest",
    "result_digest",
    "replay_material",
    "semantic_assertions"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "VALID"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "ELIGIBLE_FOR_ENFORCEMENT_CONTEXT_ASSEMBLY"
          },
          "dimension_results": {
            "$ref": "#/$defs/all_matched_dimension_results"
          },
          "semantic_assertions": {
            "properties": {
              "may_assemble_enforcement_context": {
                "const": true
              },
              "structural_refusal_required": {
                "const": false
              },
              "re_evaluation_required": {
                "const": false
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "mismatch_reasons"
              ]
            },
            {
              "required": [
                "re_evaluation_reasons"
              ]
            },
            {
              "required": [
                "missing_input_refs"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "INVALID"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "STRUCTURAL_REFUSAL_REQUIRED"
          },
          "dimension_results": {
            "$ref": "#/$defs/dimension_results_with_mismatch"
          },
          "semantic_assertions": {
            "properties": {
              "may_assemble_enforcement_context": {
                "const": false
              },
              "structural_refusal_required": {
                "const": true
              },
              "re_evaluation_required": {
                "const": false
              }
            }
          }
        },
        "required": [
          "mismatch_reasons"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "RE_EVALUATION_REQUIRED"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "RE_EVALUATION_REQUIRED"
          },
          "dimension_results": {
            "$ref": "#/$defs/dimension_results_with_reevaluation"
          },
          "semantic_assertions": {
            "properties": {
              "may_assemble_enforcement_context": {
                "const": false
              },
              "structural_refusal_required": {
                "const": false
              },
              "re_evaluation_required": {
                "const": true
              }
            }
          }
        },
        "required": [
          "re_evaluation_reasons"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "INDETERMINATE"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "EVALUATION_BLOCKED"
          },
          "dimension_results": {
            "$ref": "#/$defs/dimension_results_with_indeterminate"
          },
          "semantic_assertions": {
            "properties": {
              "may_assemble_enforcement_context": {
                "const": false
              },
              "structural_refusal_required": {
                "const": false
              },
              "re_evaluation_required": {
                "const": true
              }
            }
          }
        },
        "required": [
          "missing_input_refs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "current_binding": {
            "properties": {
              "bind_conditions": {
                "properties": {
                  "binding_mode": {
                    "const": "SINGLE_TRANSITION"
                  }
                }
              }
            }
          }
        },
        "required": [
          "current_binding"
        ]
      },
      "then": {
        "properties": {
          "dimension_results": {
            "properties": {
              "bind_conditions": {
                "properties": {
                  "status": {
                    "enum": [
                      "MATCHED",
                      "NOT_APPLICABLE"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "current_binding": {
            "properties": {
              "bind_conditions": {
                "properties": {
                  "binding_mode": {
                    "enum": [
                      "COMPOSITE_COMPLETE_BIND",
                      "COMPOSITE_PARTIAL_BIND"
                    ]
                  }
                }
              }
            }
          }
        },
        "required": [
          "current_binding"
        ]
      },
      "then": {
        "properties": {
          "dimension_results": {
            "properties": {
              "bind_conditions": {
                "properties": {
                  "status": {
                    "not": {
                      "const": "NOT_APPLICABLE"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "governance_binding_validation_result_id": {
      "allOf": [
        {
          "$ref": "common.json#/$defs/identifier"
        }
      ],
      "description": "Stable Governance Binding Validation Result identifier."
    },
    "binding_validation_outcome": {
      "type": "string",
      "enum": [
        "VALID",
        "INVALID",
        "RE_EVALUATION_REQUIRED",
        "INDETERMINATE"
      ]
    },
    "binding_validation_disposition": {
      "type": "string",
      "enum": [
        "ELIGIBLE_FOR_ENFORCEMENT_CONTEXT_ASSEMBLY",
        "STRUCTURAL_REFUSAL_REQUIRED",
        "RE_EVALUATION_REQUIRED",
        "EVALUATION_BLOCKED"
      ]
    },
    "binding_mode": {
      "type": "string",
      "enum": [
        "SINGLE_TRANSITION",
        "COMPOSITE_COMPLETE_BIND",
        "COMPOSITE_PARTIAL_BIND"
      ]
    },
    "decision_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "governance_decision_ref": {
          "$ref": "governance_decision_result.json#/$defs/governance_decision_result_ref"
        },
        "decision_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "proposal_id": {
          "$ref": "common.json#/$defs/proposal_id"
        },
        "tenant_id": {
          "$ref": "common.json#/$defs/tenant_id"
        },
        "target_ref": {
          "$ref": "common.json#/$defs/target_ref"
        },
        "governance_version_ref": {
          "$ref": "common.json#/$defs/governance_version_ref"
        }
      },
      "required": [
        "governance_decision_ref",
        "decision_digest",
        "proposal_id",
        "tenant_id",
        "target_ref",
        "governance_version_ref"
      ]
    },
    "authorization_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_authorization_ref": {
          "$ref": "execution_authorization_view.json#/$defs/execution_authorization_view_ref"
        },
        "authorization_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "proposal_id": {
          "$ref": "common.json#/$defs/proposal_id"
        },
        "tenant_id": {
          "$ref": "common.json#/$defs/tenant_id"
        },
        "target_ref": {
          "$ref": "common.json#/$defs/target_ref"
        },
        "validity_window": {
          "$ref": "common.json#/$defs/validity_window"
        },
        "governance_version_ref": {
          "$ref": "common.json#/$defs/governance_version_ref"
        },
        "consumed": {
          "type": "boolean"
        }
      },
      "required": [
        "execution_authorization_ref",
        "authorization_digest",
        "proposal_id",
        "tenant_id",
        "target_ref",
        "validity_window",
        "governance_version_ref",
        "consumed"
      ]
    },
    "authority_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority_rederivation_result_ref": {
          "$ref": "authority_rederivation_result.json#/$defs/authority_rederivation_result_ref"
        },
        "outcome": {
          "const": "AUTHORITY_ESTABLISHED"
        },
        "authority_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "proposal_specific": {
          "const": true
        },
        "portable_or_reusable": {
          "const": false
        },
        "permission_to_execute": {
          "const": false
        }
      },
      "required": [
        "authority_rederivation_result_ref",
        "outcome",
        "authority_digest",
        "proposal_specific",
        "portable_or_reusable",
        "permission_to_execute"
      ]
    },
    "canonical_state_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical_state_ref": {
          "$ref": "common.json#/$defs/canonical_state_ref"
        },
        "state_qualification_result_ref": {
          "allOf": [
            {
              "$ref": "state_qualification_result.json#/$defs/state_qualification_result_ref"
            },
            {
              "properties": {
                "outcome": {
                  "const": "QUALIFIED"
                }
              },
              "required": [
                "outcome"
              ]
            }
          ]
        },
        "state_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "current_for_evaluation_horizon": {
          "const": true
        }
      },
      "required": [
        "canonical_state_ref",
        "state_qualification_result_ref",
        "state_digest",
        "current_for_evaluation_horizon"
      ]
    },
    "bind_conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding_mode": {
          "$ref": "#/$defs/binding_mode"
        },
        "bind_set_ref": {
          "$ref": "bind_set.json#/$defs/bind_set_ref"
        },
        "dependency_graph_ref": {
          "$ref": "governance_dependency_graph.json#/$defs/governance_dependency_graph_ref"
        },
        "deterministic_adjudication_result_ref": {
          "$ref": "deterministic_adjudication_result.json#/$defs/deterministic_adjudication_result_ref"
        },
        "resulting_state_validation_result_ref": {
          "$ref": "resulting_state_validation_result.json#/$defs/resulting_state_validation_result_ref"
        },
        "coupling_semantics": {
          "$ref": "common.json#/$defs/composite_coupling_semantics_enum"
        },
        "approved_executable_subset_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "partial_bind_admissibility_established": {
          "type": "boolean"
        },
        "bind_conditions_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "binding_mode",
        "bind_conditions_digest"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "binding_mode": {
                "const": "SINGLE_TRANSITION"
              }
            },
            "required": [
              "binding_mode"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "bind_set_ref"
                  ]
                },
                {
                  "required": [
                    "dependency_graph_ref"
                  ]
                },
                {
                  "required": [
                    "deterministic_adjudication_result_ref"
                  ]
                },
                {
                  "required": [
                    "approved_executable_subset_digest"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "binding_mode": {
                "const": "COMPOSITE_COMPLETE_BIND"
              }
            },
            "required": [
              "binding_mode"
            ]
          },
          "then": {
            "required": [
              "bind_set_ref",
              "dependency_graph_ref",
              "resulting_state_validation_result_ref",
              "coupling_semantics"
            ],
            "properties": {
              "partial_bind_admissibility_established": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "binding_mode": {
                "const": "COMPOSITE_PARTIAL_BIND"
              }
            },
            "required": [
              "binding_mode"
            ]
          },
          "then": {
            "required": [
              "bind_set_ref",
              "dependency_graph_ref",
              "deterministic_adjudication_result_ref",
              "resulting_state_validation_result_ref",
              "coupling_semantics",
              "approved_executable_subset_digest",
              "partial_bind_admissibility_established"
            ],
            "properties": {
              "partial_bind_admissibility_established": {
                "const": true
              },
              "coupling_semantics": {
                "not": {
                  "const": "STRONGLY_COUPLED"
                }
              }
            }
          }
        }
      ]
    },
    "governance_binding": {
      "type": "object",
      "description": "Complete proposal-specific governance relationship set whose continuity is validated immediately before enforcement and commitment.",
      "additionalProperties": false,
      "properties": {
        "proposal_identity": {
          "$ref": "common.json#/$defs/proposal_identity"
        },
        "governance_decision": {
          "$ref": "#/$defs/decision_binding"
        },
        "execution_authorization": {
          "$ref": "#/$defs/authorization_binding"
        },
        "authority": {
          "$ref": "#/$defs/authority_binding"
        },
        "qualified_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "evidence_qualification_result.json#/$defs/qualified_evidence_ref"
          },
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true
        },
        "target_ref": {
          "$ref": "common.json#/$defs/target_ref"
        },
        "tenant_id": {
          "$ref": "common.json#/$defs/tenant_id"
        },
        "governance_domain_id": {
          "$ref": "common.json#/$defs/governance_domain_id"
        },
        "policy_refs": {
          "type": "array",
          "items": {
            "$ref": "policy_artifact.json#/$defs/policy_artifact_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "canonical_state": {
          "$ref": "#/$defs/canonical_state_binding"
        },
        "lifecycle_state_ref": {
          "$ref": "governance_lifecycle_record.json#/$defs/lifecycle_state_ref"
        },
        "scope": {
          "$ref": "common.json#/$defs/governance_scope"
        },
        "validity_window": {
          "$ref": "common.json#/$defs/validity_window"
        },
        "governance_version_ref": {
          "$ref": "common.json#/$defs/governance_version_ref"
        },
        "governance_configuration_ref": {
          "$ref": "governance_configuration.json#/$defs/governance_configuration_ref"
        },
        "bind_conditions": {
          "$ref": "#/$defs/bind_conditions"
        },
        "binding_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "proposal_identity",
        "governance_decision",
        "execution_authorization",
        "authority",
        "qualified_evidence_refs",
        "target_ref",
        "tenant_id",
        "governance_domain_id",
        "policy_refs",
        "canonical_state",
        "lifecycle_state_ref",
        "scope",
        "validity_window",
        "governance_version_ref",
        "governance_configuration_ref",
        "bind_conditions",
        "binding_digest"
      ]
    },
    "comparison_basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comparison_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evaluated_binding_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "current_binding_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "identity_comparison_performed": {
          "const": true
        },
        "digest_comparison_performed": {
          "const": true
        },
        "scope_comparison_performed": {
          "const": true
        },
        "temporal_comparison_performed": {
          "const": true
        },
        "current_qualified_inputs_used": {
          "const": true
        },
        "arrival_time_used_as_governance_basis": {
          "const": false
        }
      },
      "required": [
        "comparison_profile",
        "evaluated_binding_digest",
        "current_binding_digest",
        "identity_comparison_performed",
        "digest_comparison_performed",
        "scope_comparison_performed",
        "temporal_comparison_performed",
        "current_qualified_inputs_used",
        "arrival_time_used_as_governance_basis"
      ]
    },
    "dimension_status": {
      "type": "string",
      "enum": [
        "MATCHED",
        "MISMATCHED",
        "RE_EVALUATION_REQUIRED",
        "INDETERMINATE",
        "NOT_APPLICABLE"
      ]
    },
    "dimension_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/dimension_status"
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evaluated_value_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "current_value_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "governance_evidence.json#/$defs/governance_evidence_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "evaluated_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        }
      },
      "required": [
        "status",
        "basis",
        "evaluated_at"
      ]
    },
    "binding_dimension_results": {
      "type": "object",
      "additionalProperties": false,
