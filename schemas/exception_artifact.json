{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.ai/schemas/exception_artifact.json",
  "title": "Governance Exception Artifact",
  "description": "Canonical attributable, versioned, integrity-protected governance exception artifact. DS-009 permits only narrowly scoped, time-bounded, authority-backed and externally approved modification of ordinary exceptionable constraint evaluation. It cannot override protected or constitutional constraints, cannot override governance invariants, cannot establish authority at commitment, and is authoritative for runtime use only after DS-042 compilation and DS-043 Controlled Governance Activation.",
  "x-agcp-ds-id": "DS-009",
  "x-agcp-lifecycle-state": "Implemented",
  "x-agcp-catalog": "catalog/schema-catalog.json",
  "x-agcp-traceability": {
    "arm_ids": [
      "ARM-501",
      "ARM-502",
      "ARM-504",
      "ARM-505",
      "ARM-506",
      "ARM-507",
      "ARM-508",
      "ARM-509",
      "ARM-510",
      "ARM-511",
      "ARM-512"
    ],
    "ns_ids": [
      "NS-15.1-01",
      "NS-15.2-02",
      "NS-15.3-02",
      "NS-15.4-01",
      "NS-15.4-02",
      "NS-15.5-01",
      "NS-15.5-02",
      "NS-15.5-03",
      "NS-15.6-01",
      "NS-15.6-02",
      "NS-15.6-03",
      "NS-15.6A-01",
      "NS-15.6A-02",
      "NS-15.6A-03",
      "NS-15.6A-04",
      "NS-15.6B-01",
      "NS-15.6B-02",
      "NS-15.7-01"
    ],
    "cr_ids": [
      "CR-110",
      "CR-111",
      "CR-112",
      "CR-113",
      "CR-114",
      "CR-117"
    ],
    "specification_version": "v2.0",
    "repository_path": "schemas/exception_artifact.json"
  },
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "exception_artifact_id": {
      "type": "string",
      "pattern": "^EXC-[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "exception_type": {
      "type": "string",
      "enum": [
        "ORDINARY_CONSTRAINT_EXCEPTION",
        "TEMPORARY_RISK_ACCEPTANCE",
        "GOVERNED_DEFERMENT",
        "RE_EVALUATION_TRIGGER",
        "ESCALATION_REQUIREMENT"
      ]
    },
    "exception_effect": {
      "type": "string",
      "enum": [
        "NARROWLY_MODIFY_ORDINARY_CONSTRAINT_EVALUATION",
        "REQUIRE_GOVERNED_RE_EVALUATION",
        "DEFER_DECISION",
        "REQUIRE_ESCALATION",
        "RECORD_ONLY"
      ]
    },
    "source_governance_intent_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "governance_intent_id": {
          "$ref": "common.json#/$defs/identifier"
        },
        "intent_version": {
          "$ref": "common.json#/$defs/version_string"
        },
        "intent_uri": {
          "$ref": "common.json#/$defs/uri"
        },
        "intent_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "governance_intent_id",
        "intent_version",
        "intent_uri",
        "intent_digest"
      ]
    },
    "exception_effective_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "$ref": "common.json#/$defs/tenant_id"
        },
        "governance_domain_id": {
          "$ref": "common.json#/$defs/governance_domain_id"
        },
        "proposal_ids": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/proposal_id"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "target_ids": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/target_id"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "action_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "resource_uris": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/uri"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "governance_stages": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/governance_pipeline_stage_enum"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "scope_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "description": "Bounded exception scope. At least one proposal, target, action type, resource, or governance stage must be declared.",
      "required": [
        "tenant_id",
        "governance_domain_id",
        "scope_digest"
      ],
      "anyOf": [
        {
          "required": [
            "proposal_ids"
          ]
        },
        {
          "required": [
            "target_ids"
          ]
        },
        {
          "required": [
            "action_types"
          ]
        },
        {
          "required": [
            "resource_uris"
          ]
        },
        {
          "required": [
            "governance_stages"
          ]
        }
      ]
    },
    "affected_constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constraint_ref": {
          "allOf": [
            {
              "$ref": "constraint_artifact.json#/$defs/constraint_artifact_ref"
            },
            {
              "properties": {
                "constraint_classification": {
                  "const": "ORDINARY"
                }
              },
              "required": [
                "constraint_classification"
              ]
            }
          ]
        },
        "exceptionability_snapshot": {
          "const": "EXCEPTIONABLE"
        },
        "original_constraint_semantics_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "modified_evaluation_semantics_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "scope_attenuation_verified": {
          "const": true
        },
        "protected_property_impact": {
          "const": "NONE"
        },
        "application_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "description": "An ordinary exceptionable constraint whose evaluation may be narrowly modified. Protected and constitutional constraints cannot appear here.",
      "required": [
        "constraint_ref",
        "exceptionability_snapshot",
        "original_constraint_semantics_digest",
        "modified_evaluation_semantics_digest",
        "scope_attenuation_verified",
        "protected_property_impact",
        "application_reason"
      ]
    },
    "lineage_step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "$ref": "common.json#/$defs/identifier"
        },
        "step_type": {
          "type": "string",
          "enum": [
            "SOURCE_INTENT",
            "POLICY_BASIS",
            "CONSTRAINT_BASIS",
            "AUTHORITY_DERIVATION",
            "APPROVAL",
            "COMPILATION",
            "VALIDATION",
            "ACTIVATION",
            "SUPERSESSION",
            "RETIREMENT"
          ]
        },
        "source_ref": {
          "$ref": "common.json#/$defs/uri"
        },
        "source_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "derived_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "performed_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "attribution": {
          "$ref": "common.json#/$defs/attribution"
        }
      },
      "required": [
        "step_id",
        "step_type",
        "source_ref",
        "source_digest",
        "derived_digest",
        "performed_at",
        "attribution"
      ]
    },
    "source_lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineage_id": {
          "$ref": "common.json#/$defs/lineage_id"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lineage_step"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "lineage_complete": {
          "const": true
        },
        "lineage_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "lineage_id",
        "steps",
        "lineage_complete",
        "lineage_digest"
      ]
    },
    "exception_source_representation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "canonicalization_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_uri": {
          "$ref": "common.json#/$defs/uri"
        },
        "source_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "machine_readable": {
          "const": true
        }
      },
      "required": [
        "media_type",
        "canonicalization_profile",
        "source_uri",
        "source_digest",
        "machine_readable"
      ]
    },
    "governance_configuration_binding": {
      "oneOf": [
        {
          "$ref": "governance_configuration.json#/$defs/governance_configuration_candidate_ref"
        },
        {
          "$ref": "governance_configuration.json#/$defs/governance_configuration_ref"
        }
      ]
    },
    "authority_basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority_lineage_ref": {
          "$ref": "authority_lineage.json#/$defs/authority_lineage_ref"
        },
        "delegation_artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "delegation_artifact.json#/$defs/delegation_artifact_ref"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "authority_scope": {
          "$ref": "common.json#/$defs/governance_scope"
        },
        "authority_valid_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "revocation_status_checked": {
          "const": true
        },
        "subject_eligibility_confirmed": {
          "const": true
        },
        "recursive_authority_containment_verified": {
          "const": true
        },
        "cross_domain_authority_isolation_verified": {
          "const": true
        },
        "authority_basis_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "authority_lineage_ref",
        "authority_scope",
        "authority_valid_at",
        "revocation_status_checked",
        "subject_eligibility_confirmed",
        "recursive_authority_containment_verified",
        "cross_domain_authority_isolation_verified",
        "authority_basis_digest"
      ]
    },
    "approval_basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approval_artifact_refs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "governance_approval_artifact.json#/$defs/governance_approval_artifact_ref"
              },
              {
                "properties": {
                  "decision": {
                    "enum": [
                      "APPROVE",
                      "RISK_ACCEPTANCE"
                    ]
                  },
                  "status": {
                    "const": "ACTIVE"
                  }
                },
                "required": [
                  "decision",
                  "status"
                ]
              }
            ]
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "completed_quorum_verified": {
          "const": true
        },
        "negative_adjudication_present": {
          "const": false
        },
        "approval_scope_contains_exception": {
          "const": true
        },
        "approval_validity_contains_exception": {
          "const": true
        },
        "external_approval_required": {
          "const": true
        },
        "approval_basis_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "approval_artifact_refs",
        "completed_quorum_verified",
        "negative_adjudication_present",
        "approval_scope_contains_exception",
        "approval_validity_contains_exception",
        "external_approval_required",
        "approval_basis_digest"
      ]
    },
    "bounded_validity_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "not_before": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "expires_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        }
      },
      "description": "Exception validity is always explicitly bounded. Semantic validation confirms not_before precedes expires_at.",
      "required": [
        "not_before",
        "expires_at"
      ]
    },
    "application_condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "$ref": "common.json#/$defs/identifier"
        },
        "attribute_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "operator": {
          "type": "string",
          "enum": [
            "EQUALS",
            "NOT_EQUALS",
            "IN",
            "NOT_IN",
            "LESS_THAN",
            "LESS_THAN_OR_EQUAL",
            "GREATER_THAN",
            "GREATER_THAN_OR_EQUAL",
            "MATCHES",
            "EXISTS"
          ]
        },
        "expected_value_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "authoritative_source_required": {
          "const": true
        }
      },
      "required": [
        "condition_id",
        "attribute_path",
        "operator",
        "authoritative_source_required"
      ]
    },
    "exception_semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exception_effect": {
          "$ref": "#/$defs/exception_effect"
        },
        "application_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/application_condition"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "modifies_evaluation_only": {
          "const": true
        },
        "source_artifacts_immutable": {
          "const": true
        },
        "automatic_expiration": {
          "const": true
        },
        "post_expiration_disposition": {
          "type": "string",
          "enum": [
            "REVERT_TO_UNEXCEPTED_EVALUATION",
            "REQUIRE_RE_EVALUATION",
            "STRUCTURAL_REFUSAL_IF_NO_ADMISSIBLE_PATH"
          ]
        },
        "record_in_governance_decision_basis": {
          "const": true
        },
        "record_in_governance_evidence": {
          "const": true
        },
        "exception_semantics_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "exception_effect",
        "application_conditions",
        "modifies_evaluation_only",
        "source_artifacts_immutable",
        "automatic_expiration",
        "post_expiration_disposition",
        "record_in_governance_decision_basis",
        "record_in_governance_evidence",
        "exception_semantics_digest"
      ]
    },
    "protected_governance_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewed_constraint_refs": {
          "type": "array",
          "items": {
            "$ref": "constraint_artifact.json#/$defs/constraint_artifact_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "reviewed_invariant_refs": {
          "type": "array",
          "items": {
            "$ref": "invariant_definition.json#/$defs/invariant_definition_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "no_protected_or_constitutional_constraint_affected": {
          "const": true
        },
        "no_invariant_overridden": {
          "const": true
        },
        "no_constitutional_safeguard_disabled": {
          "const": true
        },
        "review_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "governance_evidence.json#/$defs/governance_evidence_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "review_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "no_protected_or_constitutional_constraint_affected",
        "no_invariant_overridden",
        "no_constitutional_safeguard_disabled",
        "review_evidence_refs",
        "review_digest"
      ]
    },
    "non_weakening_semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protected_constraints_preserved": {
          "const": true
        },
        "constitutional_constraints_preserved": {
          "const": true
        },
        "governance_invariants_preserved": {
          "const": true
        },
        "scope_expansion_prohibited": {
          "const": true
        },
        "authority_amplification_prohibited": {
          "const": true
        },
        "safeguard_disabling_prohibited": {
          "const": true
        },
        "bypass_prohibited": {
          "const": true
        },
        "omission_prohibited": {
          "const": true
        },
        "non_weakening_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "protected_constraints_preserved",
        "constitutional_constraints_preserved",
        "governance_invariants_preserved",
        "scope_expansion_prohibited",
        "authority_amplification_prohibited",
        "safeguard_disabling_prohibited",
        "bypass_prohibited",
        "omission_prohibited",
        "non_weakening_digest"
      ]
    },
    "compilation_projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compiled_governance_artifact_ref": {
          "$ref": "compiled_governance_artifact.json#/$defs/compiled_governance_artifact_ref"
        },
        "compilation_status": {
          "$ref": "compiled_governance_artifact.json#/$defs/compilation_status"
        },
        "source_manifest_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "validated_dependency_set_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "machine_evaluable_representation_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "governance_artifact_lineage_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "constitutional_validation_outcome": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASSED",
            "FAILED",
            "INDETERMINATE"
          ]
        },
        "governance_omission_analysis_outcome": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASSED",
            "FAILED",
            "INDETERMINATE"
          ]
        },
        "governance_self_protection_outcome": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASSED",
            "FAILED",
            "INDETERMINATE"
          ]
        },
        "protected_governance_preserved": {
          "type": "boolean"
        },
        "prohibited_weakening_detected": {
          "type": "boolean"
        },
        "material_omission_detected": {
          "type": "boolean"
        },
        "activation_eligibility": {
          "$ref": "compiled_governance_artifact.json#/$defs/activation_eligibility"
        },
        "projection_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "governance_evidence.json#/$defs/governance_evidence_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "projection_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "compiled_governance_artifact_ref",
        "compilation_status",
        "source_manifest_digest",
        "validated_dependency_set_digest",
        "machine_evaluable_representation_digest",
        "governance_artifact_lineage_digest",
        "constitutional_validation_outcome",
        "governance_omission_analysis_outcome",
        "governance_self_protection_outcome",
        "protected_governance_preserved",
        "prohibited_weakening_detected",
        "material_omission_detected",
        "activation_eligibility",
        "projection_evidence_refs",
        "projection_digest"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "compilation_status": {
                "const": "VALIDATED"
              }
            },
            "required": [
              "compilation_status"
            ]
          },
          "then": {
            "properties": {
              "constitutional_validation_outcome": {
                "const": "PASSED"
              },
              "governance_omission_analysis_outcome": {
                "const": "PASSED"
              },
              "governance_self_protection_outcome": {
                "const": "PASSED"
              },
              "protected_governance_preserved": {
                "const": true
              },
              "prohibited_weakening_detected": {
                "const": false
              },
              "material_omission_detected": {
                "const": false
              },
              "activation_eligibility": {
                "const": "ELIGIBLE"
              }
            },
            "required": [
              "constitutional_validation_outcome",
              "governance_omission_analysis_outcome",
              "governance_self_protection_outcome",
              "protected_governance_preserved",
              "prohibited_weakening_detected",
              "material_omission_detected",
              "activation_eligibility"
            ]
          }
        }
      ]
    },
    "governed_re_evaluation_basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis_id": {
          "$ref": "common.json#/$defs/identifier"
        },
        "material_change_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "change_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "governance_evidence.json#/$defs/governance_evidence_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "affected_semantics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "SCOPE",
              "AUTHORITY",
              "APPROVAL",
              "VALIDITY",
              "POLICY",
              "CONSTRAINT",
              "PROTECTED_GOVERNANCE_REVIEW",
              "COMPILATION",
              "ACTIVATION"
            ]
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "required_disposition": {
          "type": "string",
          "enum": [
            "REVALIDATE",
            "REAPPROVE",
            "RECOMPILE",
            "REACTIVATE",
            "EXPIRE",
            "RETIRE",
            "SUPERSEDE"
          ]
        },
        "determined_at": {
