{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.ai/schemas/tenant.json",
  "title": "AGCP Tenant Governance Record",
  "description": "Canonical, attributable, versioned, integrity-protected Tenant governance record. DS-004 records the authoritative Tenant operational state and state version, append-only state history and transition basis, active and historical Governance Configuration versions, Tenant Governance Evidence, explicit Tenant and Governance Domain Isolation controls, registry bindings, and complete record integrity. It does not itself establish authority at commitment, authorize execution, or override Canonical State.",
  "$comment": "DS-004 implements the serialized Tenant and Governance Domain Isolation record required by Core Sections 7.4 and 11.1 through 11.7. JSON Schema validates structural and state-specific consistency. Implementations must additionally verify cross-record equality, ordered history continuity, current-state and current-configuration correspondence, ledger existence, signature validity, evidence availability, and effective isolation in the deployed enforcement scope.",
  "x-agcp-ds-id": "DS-004",
  "x-agcp-lifecycle-state": "Implemented",
  "x-agcp-catalog": "catalog/schema-catalog.json",
  "x-agcp-schema-role": "Tenant Governance State, Configuration History, Evidence, and Isolation Record",
  "x-agcp-normative-basis": {
    "architecture_reference_model": [
      "ARM-202",
      "ARM-204",
      "ARM-305",
      "ARM-401",
      "ARM-406",
      "ARM-703",
      "ARM-704",
      "ARM-706",
      "ARM-801"
    ],
    "core_sections": [
      "5.5",
      "7.4",
      "10.5",
      "10.8A",
      "10.9",
      "11.1",
      "11.2",
      "11.3",
      "11.4",
      "11.5",
      "11.6",
      "11.7"
    ],
    "normative_statements": [
      "NS-7.4-03",
      "NS-10.5-01",
      "NS-10.8A-01",
      "NS-10.9-02",
      "NS-11.1-01",
      "NS-11.1-02",
      "NS-11.2-01",
      "NS-11.2-02",
      "NS-11.3-01",
      "NS-11.3-02",
      "NS-11.4-01",
      "NS-11.4-02",
      "NS-11.5-01",
      "NS-11.5-02",
      "NS-11.5-03",
      "NS-11.6-03",
      "NS-11.6-04",
      "NS-11.7-01",
      "NS-11.7-02",
      "NS-11.7-03"
    ],
    "conformance_requirements": [
      "CR-006",
      "CR-024",
      "CR-025",
      "CR-026",
      "CR-027",
      "CR-028",
      "CR-029",
      "CR-030"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "tenant_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^TENANT-RECORD-[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable identity for the versioned Tenant governance record."
    },
    "tenant_state": {
      "type": "string",
      "enum": [
        "PROVISIONED",
        "ACTIVE",
        "INACTIVE",
        "SUSPENDED",
        "DECOMMISSIONED"
      ],
      "description": "Authoritative Tenant operational state. INACTIVE is distinct from SUSPENDED and DECOMMISSIONED."
    },
    "operational_eligibility": {
      "type": "string",
      "enum": [
        "ELIGIBLE",
        "INELIGIBLE"
      ],
      "description": "Whether the Tenant is operationally eligible for governance authorization and commitment. Only ACTIVE may be ELIGIBLE."
    },
    "state_transition_kind": {
      "type": "string",
      "enum": [
        "INITIAL_PROVISIONING",
        "ACTIVATION",
        "DEACTIVATION",
        "SUSPENSION",
        "REACTIVATION",
        "DECOMMISSIONING",
        "GOVERNED_RECOVERY",
        "GOVERNED_CORRECTION"
      ]
    },
    "transition_basis_type": {
      "type": "string",
      "enum": [
        "PROVISIONING_AUTHORITY",
        "GOVERNANCE_DECISION",
        "GOVERNANCE_ADMINISTRATION",
        "POLICY_OR_CONFIGURATION_CHANGE",
        "SECURITY_OR_ISOLATION_EVENT",
        "RECOVERY_DECISION",
        "DECOMMISSIONING_AUTHORITY",
        "GOVERNED_CORRECTION"
      ]
    },
    "integrity_bound_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "type": "string",
          "enum": [
            "GOVERNANCE_DECISION",
            "GOVERNANCE_APPROVAL",
            "POLICY",
            "GOVERNANCE_CONFIGURATION",
            "CONTROLLED_ACTIVATION",
            "SECURITY_EVENT",
            "ISOLATION_VALIDATION",
            "ADMINISTRATIVE_GOVERNANCE_RECORD",
            "OTHER_GOVERNANCE_ARTIFACT"
          ]
        },
        "artifact_id": {
          "$ref": "common.json#/$defs/identifier"
        },
        "artifact_version": {
          "$ref": "common.json#/$defs/version_string"
        },
        "artifact_uri": {
          "$ref": "common.json#/$defs/uri"
        },
        "artifact_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "artifact_type",
        "artifact_id",
        "artifact_digest"
      ]
    },
    "state_transition_basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis_type": {
          "$ref": "#/$defs/transition_basis_type"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_:-]*$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "source_artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/integrity_bound_artifact_ref"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "approval_artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "governance_approval_artifact.json#/$defs/governance_approval_artifact_ref"
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "applicable_policy_refs": {
          "type": "array",
          "items": {
            "$ref": "policy_artifact.json#/$defs/policy_artifact_ref"
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "transition_authorized": {
          "const": true
        },
        "tenant_domain_binding_verified": {
          "const": true
        },
        "basis_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "basis_type",
        "reason_code",
        "rationale",
        "source_artifact_refs",
        "transition_authorized",
        "tenant_domain_binding_verified",
        "basis_digest"
      ]
    },
    "tenant_state_transition_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^TENANT-STATE-TRANSITION-[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "resulting_state": {
          "$ref": "#/$defs/tenant_state"
        },
        "resulting_state_version": {
          "$ref": "common.json#/$defs/version_string"
        },
        "transition_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "effective_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        }
      },
      "required": [
        "transition_id",
        "resulting_state",
        "resulting_state_version",
        "transition_digest",
        "effective_at"
      ]
    },
    "tenant_state_history_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^TENANT-STATE-TRANSITION-[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "sequence": {
          "$ref": "common.json#/$defs/sequence_number"
        },
        "transition_kind": {
          "$ref": "#/$defs/state_transition_kind"
        },
        "prior_state": {
          "oneOf": [
            {
              "$ref": "#/$defs/tenant_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "prior_state_version": {
          "oneOf": [
            {
              "$ref": "common.json#/$defs/version_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "resulting_state": {
          "$ref": "#/$defs/tenant_state"
        },
        "resulting_state_version": {
          "$ref": "common.json#/$defs/version_string"
        },
        "transition_basis": {
          "$ref": "#/$defs/state_transition_basis"
        },
        "effective_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "recorded_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "ledger_event_ref": {
          "$ref": "governance_ledger_event.json#/$defs/governance_ledger_event_ref"
        },
        "governance_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "governance_evidence.json#/$defs/governance_evidence_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "attribution": {
          "$ref": "common.json#/$defs/attribution"
        },
        "predecessor_transition_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "transition_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "transition_id",
        "sequence",
        "transition_kind",
        "prior_state",
        "prior_state_version",
        "resulting_state",
        "resulting_state_version",
        "transition_basis",
        "effective_at",
        "recorded_at",
        "ledger_event_ref",
        "governance_evidence_refs",
        "attribution",
        "transition_digest"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "sequence": {
                "const": 0
              }
            },
            "required": [
              "sequence"
            ]
          },
          "then": {
            "properties": {
              "prior_state": {
                "type": "null"
              },
              "prior_state_version": {
                "type": "null"
              }
            },
            "not": {
              "required": [
                "predecessor_transition_digest"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "sequence": {
                "minimum": 1
              }
            },
            "required": [
              "sequence"
            ]
          },
          "then": {
            "properties": {
              "prior_state": {
                "$ref": "#/$defs/tenant_state"
              },
              "prior_state_version": {
                "$ref": "common.json#/$defs/version_string"
              }
            },
            "required": [
              "predecessor_transition_digest"
            ]
          }
        }
      ]
    },
    "history_integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "append_only": {
          "const": true
        },
        "in_place_rewrite_prohibited": {
          "const": true
        },
        "sequence_continuity_verified": {
          "const": true
        },
        "predecessor_chain_verified": {
          "const": true
        },
        "current_record_matches_latest_history_entry": {
          "const": true
        },
        "history_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "verified_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        }
      },
      "required": [
        "append_only",
        "in_place_rewrite_prohibited",
        "sequence_continuity_verified",
        "predecessor_chain_verified",
        "current_record_matches_latest_history_entry",
        "history_digest",
        "verified_at"
      ]
    },
    "configuration_history_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "RETIRED",
        "ROLLED_BACK",
        "ACTIVATION_FAILED"
      ]
    },
    "configuration_version_history_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "history_entry_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^TENANT-CONFIG-HISTORY-[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "governance_configuration_id": {
          "$ref": "common.json#/$defs/identifier"
        },
        "configuration_version": {
          "$ref": "common.json#/$defs/version_string"
        },
        "history_status": {
          "$ref": "#/$defs/configuration_history_status"
        },
        "configuration_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "entry_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "history_entry_id",
        "governance_configuration_id",
        "configuration_version",
        "history_status",
        "configuration_digest",
        "entry_digest"
      ]
    },
    "configuration_version_history_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "history_entry_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^TENANT-CONFIG-HISTORY-[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "sequence": {
          "$ref": "common.json#/$defs/sequence_number"
        },
        "governance_configuration_id": {
          "$ref": "common.json#/$defs/identifier"
        },
        "configuration_version": {
          "$ref": "common.json#/$defs/version_string"
        },
        "configuration_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "governance_version_ref": {
          "$ref": "common.json#/$defs/governance_version_ref"
        },
        "history_status": {
          "$ref": "#/$defs/configuration_history_status"
        },
        "controlled_activation_ref": {
          "$ref": "controlled_governance_activation.json#/$defs/controlled_governance_activation_ref"
        },
        "effective_from": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "effective_until": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "ledger_event_ref": {
          "$ref": "governance_ledger_event.json#/$defs/governance_ledger_event_ref"
        },
        "governance_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "governance_evidence.json#/$defs/governance_evidence_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "predecessor_entry_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "entry_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "history_entry_id",
        "sequence",
        "governance_configuration_id",
        "configuration_version",
        "configuration_digest",
        "governance_version_ref",
        "history_status",
        "controlled_activation_ref",
        "effective_from",
        "ledger_event_ref",
        "governance_evidence_refs",
        "entry_digest"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "sequence": {
                "const": 0
              }
            },
            "required": [
              "sequence"
            ]
          },
          "then": {
            "not": {
              "required": [
                "predecessor_entry_digest"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "sequence": {
                "minimum": 1
              }
            },
            "required": [
              "sequence"
            ]
          },
          "then": {
            "required": [
              "predecessor_entry_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "history_status": {
                "const": "ACTIVE"
              }
            },
            "required": [
              "history_status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "effective_until"
              ]
            },
            "properties": {
              "controlled_activation_ref": {
                "allOf": [
                  {
                    "$ref": "controlled_governance_activation.json#/$defs/controlled_governance_activation_ref"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "activation_status": {
                        "const": "ACTIVATED"
                      }
                    },
                    "required": [
                      "activation_status"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "history_status": {
                "enum": [
                  "SUPERSEDED",
                  "RETIRED",
                  "ROLLED_BACK"
                ]
              }
            },
            "required": [
              "history_status"
            ]
          },
          "then": {
            "required": [
              "effective_until"
            ]
          }
        }
      ]
    },
    "cross_domain_relationship_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relationship_id": {
          "$ref": "common.json#/$defs/identifier"
        },
        "counterparty_tenant_id": {
          "$ref": "common.json#/$defs/tenant_id"
        },
        "counterparty_governance_domain_id": {
          "$ref": "common.json#/$defs/governance_domain_id"
        },
        "permitted_interaction_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "VISIBILITY",
              "APPROVAL",
              "POLICY_REFERENCE",
              "EVIDENCE_REFERENCE",
              "AUTHORITY_DELEGATION",
              "COMPOSITE_GOVERNANCE",
              "LEDGER_REFERENCE"
            ]
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "validation_status": {
          "const": "GOVERNED_AND_VALIDATED"
        },
        "applicable_policy_refs": {
          "type": "array",
          "items": {
            "$ref": "policy_artifact.json#/$defs/policy_artifact_ref"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "authority_lineage_ref": {
          "$ref": "authority_lineage.json#/$defs/authority_lineage_ref"
        },
        "validity": {
          "$ref": "common.json#/$defs/validity_window"
        },
        "governance_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "governance_evidence.json#/$defs/governance_evidence_ref"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "relationship_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "relationship_id",
        "counterparty_tenant_id",
        "counterparty_governance_domain_id",
        "permitted_interaction_types",
        "validation_status",
        "applicable_policy_refs",
        "validity",
        "governance_evidence_refs",
        "relationship_digest"
      ]
    },
    "tenant_isolation_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isolation_boundary_id": {
          "$ref": "common.json#/$defs/identifier"
        },
        "isolation_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "FAILED_CLOSED"
          ]
        },
        "tenant_isolation_enforced": {
          "const": true
        },
        "governance_domain_isolation_enforced": {
          "const": true
        },
        "governance_configuration_isolated": {
          "const": true
        },
        "canonical_state_isolated": {
          "const": true
        },
        "authority_lineage_isolated": {
          "const": true
        },
        "governance_evidence_isolated": {
          "const": true
        },
        "ledger_access_isolated": {
          "const": true
        },
        "policy_resolution_isolated": {
          "const": true
        },
        "cross_tenant_visibility_prohibited": {
          "const": true
        },
        "cross_tenant_authority_propagation_prohibited": {
          "const": true
        },
        "cross_tenant_execution_prohibited": {
          "const": true
        },
        "cross_tenant_evidence_commingling_prohibited": {
          "const": true
        },
        "cross_domain_interaction_mode": {
          "type": "string",
          "enum": [
            "PROHIBITED",
            "GOVERNED_ONLY"
          ]
        },
        "authorized_cross_domain_relationship_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cross_domain_relationship_ref"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "isolation_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "governance_evidence.json#/$defs/governance_evidence_ref"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "last_verified_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "isolation_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "isolation_boundary_id",
        "isolation_status",
        "tenant_isolation_enforced",
        "governance_domain_isolation_enforced",
        "governance_configuration_isolated",
        "canonical_state_isolated",
        "authority_lineage_isolated",
        "governance_evidence_isolated",
        "ledger_access_isolated",
        "policy_resolution_isolated",
        "cross_tenant_visibility_prohibited",
        "cross_tenant_authority_propagation_prohibited",
        "cross_tenant_execution_prohibited",
        "cross_tenant_evidence_commingling_prohibited",
        "cross_domain_interaction_mode",
        "isolation_evidence_refs",
        "last_verified_at",
        "isolation_digest"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "cross_domain_interaction_mode": {
                "const": "GOVERNED_ONLY"
              }
            },
            "required": [
              "cross_domain_interaction_mode"
            ]
          },
          "then": {
            "required": [
              "authorized_cross_domain_relationship_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "cross_domain_interaction_mode": {
                "const": "PROHIBITED"
              }
            },
            "required": [
              "cross_domain_interaction_mode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "authorized_cross_domain_relationship_refs"
              ]
            }
          }
        }
      ]
    },
    "tenant_replay_material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_record_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "state_history_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
