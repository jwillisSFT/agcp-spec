          "uniqueItems": true
        },
        "result_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "analysis_id",
        "outcome",
        "coverage_categories",
        "traceability_coverage_digest",
        "omission_findings"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "PASSED",
                  "MATERIAL_OMISSIONS_DETECTED",
                  "INDETERMINATE"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "analyzed_at",
              "analyst_attribution",
              "governance_evidence_refs",
              "result_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "MATERIAL_OMISSIONS_DETECTED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "omission_findings": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
