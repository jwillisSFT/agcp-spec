    "constitutional_validation_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "validation_id": {
          "$ref": "common.json#/$defs/evaluation_id"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PENDING",
            "PASSED",
            "FAILED",
            "INDETERMINATE"
          ]
        },
        "protected_safeguard_set_digest": {
          "$ref": "common.json#/$defs/content_digest"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constitutional_finding"
          },
          "maxItems": 2048
        },
        "evaluated_at": {
          "$ref": "common.json#/$defs/timestamp_rfc3339"
        },
        "evaluator_attribution": {
          "$ref": "common.json#/$defs/attribution"
        },
        "governance_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "governance_evidence.json#/$defs/governance_evidence_ref"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "result_digest": {
          "$ref": "common.json#/$defs/content_digest"
        }
      },
      "required": [
        "validation_id",
        "outcome",
        "protected_safeguard_set_digest",
        "findings"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "PASSED",
                  "FAILED",
                  "INDETERMINATE"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "evaluated_at",
              "evaluator_attribution",
              "governance_evidence_refs",
              "result_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "FAILED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "findings": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "PASSED"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "findings": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
