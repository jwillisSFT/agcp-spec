{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.example/schemas/invariant_evaluation.json",
  "title": "Invariant Evaluation",
  "description": "Result of evaluating a single AGCP invariant during governance processing.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "invariant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "invariant_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Invariant type identifier from the invariant-type registry."
    },
    "enforcement_level": {
      "$ref": "common.json#/$defs/invariant_enforcement_enum"
    },
    "governance_stage": {
      "$ref": "common.json#/$defs/governance_pipeline_stage_enum"
    },
    "outcome": {
      "$ref": "common.json#/$defs/pass_fail_enum"
    },
    "reason": {
      "type": "string",
      "maxLength": 2048
    },
    "rejection_code": {
      "$ref": "common.json#/$defs/rejection_code"
    },
    "policy_ref": {
      "$ref": "common.json#/$defs/policy_ref"
    },
    "canonical_state_ref": {
      "$ref": "common.json#/$defs/canonical_state_ref"
    },
    "authority_lineage_ref": {
      "$ref": "common.json#/$defs/authority_lineage_ref"
    },
    "evaluation_timestamp": {
      "$ref": "common.json#/$defs/timestamp_rfc3339"
    },
    "metadata": {
      "type": "object",
      "description": "Implementation-defined diagnostic metadata.",
      "additionalProperties": true
    }
  },
  "required": [
    "invariant_id",
    "invariant_type",
    "enforcement_level",
    "governance_stage",
    "outcome"
  ]
}
