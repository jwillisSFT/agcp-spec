{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.example/schemas/human_review_artifact.json",
  "title": "Human Review Artifact",
  "description": "Canonical representation of human governance review within AGCP. This artifact records review requests, reviewer decisions, approvals, denials, and associated governance evidence used to satisfy governance requirements that require human participation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "proposal_id": {
      "$ref": "common.json#/$defs/proposal_id"
    },
    "action_id": {
      "$ref": "common.json#/$defs/action_id"
    },
    "tenant_id": {
      "$ref": "common.json#/$defs/tenant_id"
    },
    "governance_domain_id": {
      "$ref": "common.json#/$defs/governance_domain_id"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected",
        "Expired",
        "Withdrawn"
      ]
    },
    "required_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Governance roles required to satisfy the review."
    },
    "reviews": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reviewer": {
            "$ref": "common.json#/$defs/principal"
          },
          "authority_lineage_ref": {
            "$ref": "common.json#/$defs/authority_lineage_ref"
          },
          "decision": {
            "type": "string",
            "enum": [
              "Approve",
              "Reject",
              "Abstain"
            ]
          },
          "review_timestamp": {
            "$ref": "common.json#/$defs/timestamp_rfc3339"
          },
          "comment": {
            "type": "string",
            "maxLength": 4096
          },
          "integrity_signature": {
            "$ref": "common.json#/$defs/signature"
          }
        },
        "required": [
          "reviewer",
          "decision",
          "review_timestamp"
        ]
      }
    },
    "quorum_satisfied": {
      "type": "boolean"
    },
    "governance_decision_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "governance_evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/stage_evidence_ref"
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "created_at": {
      "$ref": "common.json#/$defs/timestamp_rfc3339"
    },
    "completed_at": {
      "$ref": "common.json#/$defs/timestamp_rfc3339"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "review_id",
    "proposal_id",
    "tenant_id",
    "review_status",
    "required_roles",
    "quorum_satisfied",
    "created_at"
  ]
}
