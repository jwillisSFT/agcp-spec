{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.ai/api/if-002/AGCP-WASM-PEC-Error-Envelope.schema.json",
  "title": "AGCP WASM PEC Controlled Failure Envelope",
  "description": "Stable controlled failure representation for IF-002-WASM-RUST-STUDENT-SERVICE-2.0.0. No failure permits authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "failure_code",
    "failure_class",
    "safe_message",
    "retryable",
    "authorization_permitted"
  ],
  "properties": {
    "failure_code": {
      "type": "string",
      "enum": [
        "ABI_INCOMPATIBLE",
        "INVALID_INPUT",
        "INVALID_OUTPUT",
        "PROHIBITED_IMPORT",
        "MODULE_DIGEST_MISMATCH",
        "FUEL_EXHAUSTED",
        "MEMORY_LIMIT_EXCEEDED",
        "TIMEOUT",
        "WASM_TRAP",
        "OUTPUT_LIMIT_EXCEEDED",
        "RUNTIME_INCOMPATIBLE"
      ]
    },
    "failure_class": {
      "type": "string",
      "enum": [
        "CONTRACT",
        "VALIDATION",
        "RESOURCE",
        "RUNTIME",
        "OUTPUT"
      ]
    },
    "safe_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "retryable": {
      "type": "boolean"
    },
    "authorization_permitted": {
      "const": false
    },
    "trap_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "details_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
