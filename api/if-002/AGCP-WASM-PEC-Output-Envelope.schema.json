{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agcp.ai/api/if-002/AGCP-WASM-PEC-Output-Envelope.schema.json",
  "title": "AGCP WASM PEC Output Envelope",
  "description": "Canonical output envelope produced by an agcp_pec_abi_v1 Policy Evaluation Module. The GDF remains the authoritative producer of Governance Outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "abi_version",
    "evaluation_id",
    "input_digest",
    "module_digest",
    "evaluation_status"
  ],
  "properties": {
    "contract_id": {
      "const": "IF-002-WASM-RUST-STUDENT-SERVICE-2.0.0"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "abi_version": {
      "const": "agcp_pec_abi_v1"
    },
    "evaluation_id": {
      "type": "string",
      "pattern": "^PEVAL-[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "input_digest": {
      "$ref": "#/$defs/digest"
    },
    "module_digest": {
      "$ref": "#/$defs/digest"
    },
    "evaluation_status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "CONTROLLED_FAILURE"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_result",
        "constraint_results",
        "invariant_results",
        "reason_codes",
        "required_approval_refs",
        "dependency_refs",
        "deterministic_diagnostics"
      ],
      "properties": {
        "policy_result": {
          "type": "string",
          "enum": [
            "SATISFIED",
            "NOT_SATISFIED",
            "STRUCTURAL_REFUSAL",
            "HUMAN_ADJUDICATION_REQUIRED",
            "DEFERRED",
            "REEVALUATION_REQUIRED"
          ]
        },
        "constraint_results": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/evaluation_item"
          }
        },
        "invariant_results": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/evaluation_item"
          }
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          }
        },
        "required_approval_refs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          }
        },
        "dependency_refs": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          }
        },
        "deterministic_diagnostics": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
              },
              "message": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    "failure": {
      "$ref": "AGCP-WASM-PEC-Error-Envelope.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluation_status": {
            "const": "COMPLETED"
          }
        },
        "required": [
          "evaluation_status"
        ]
      },
      "then": {
        "required": [
          "result"
        ],
        "not": {
          "required": [
            "failure"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluation_status": {
            "const": "CONTROLLED_FAILURE"
          }
        },
        "required": [
          "evaluation_status"
        ]
      },
      "then": {
        "required": [
          "failure"
        ],
        "not": {
          "required": [
            "result"
          ]
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "evaluation_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "result",
        "reason_codes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "result": {
          "type": "string",
          "enum": [
            "SATISFIED",
            "VIOLATED",
            "NOT_APPLICABLE",
            "UNRESOLVED"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
          }
        }
      }
    }
  }
}
